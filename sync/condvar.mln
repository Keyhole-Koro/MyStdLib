package condvar;

import { Atomic } from "atomic.mln";
import { Mutex } from "mutex.mln";
import { Result } from "@std/core/result.mln";
import { ThreadError } from "@contracts/process/thread.contract.mln";

/**
 * Futex sequence counter; the protected condition remains in caller-owned data.
 * @property sequence Incremented before each notification so wait setup cannot lose a wake.
 */
export struct Condvar {
    Atomic<i32> sequence;
};

/** Resets the sequence counter; callers must ensure no waiter is registered. */
export void (borrow Condvar self) init() { self.sequence.store(0); }

/**
 * Unlocks mutex, waits for a sequence change, then reacquires mutex.
 * Spurious wakeup is permitted; callers must recheck their predicate in a loop.
 * @param mutex Held mutex protecting the caller's condition state.
 */
export void (borrow Condvar self) wait(borrow Mutex mutex) {
    i32 observed = self.sequence.load();
    mutex.unlock();
    self.sequence.wait(observed, 0);
    mutex.lock();
}

/**
 * Waits with a tick timeout and always reacquires mutex before returning.
 * @param mutex Held mutex protecting the caller's condition state.
 * @param ticks Relative scheduler-tick timeout; zero waits indefinitely.
 * @return Ok(_) after notification/spurious wake, or a typed timeout/futex error.
 */
export Result<_, ThreadError> (borrow Condvar self) wait_ticks(borrow Mutex mutex, i32 ticks) {
    i32 observed = self.sequence.load();
    mutex.unlock();
    Result<_, ThreadError> result = self.sequence.wait(observed, ticks);
    mutex.lock();
    return result;
}

/** Advances the sequence and wakes at most one registered waiter. */
export void (borrow Condvar self) notify_one() {
    self.sequence.fetch_add(1);
    self.sequence.wake(1);
}

/** Advances the sequence and wakes all currently registered waiters. */
export void (borrow Condvar self) notify_all() {
    self.sequence.fetch_add(1);
    self.sequence.wake(0x7FFFFFFF);
}
