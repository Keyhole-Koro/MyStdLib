package str;

import { Option } from "option.mln";

// NUL-terminated byte string helpers.
//
// A "string" here is a `char*` pointing at bytes terminated by 0, the only
// string representation MyLang has today: a literal is interned into the data
// section by the compiler and its address loaded with `movi`. There is no
// length word, so every call that needs one walks the bytes.
//
// Reads mask with 0xFF because `char` sign-extends when widened to i32, which
// would make any byte >= 0x80 compare as negative.

/** Measure a NUL-terminated string.
 * @param s String to measure.
 * @return Number of bytes before the terminator.
 */
export i32 len(char* s) {
    i32 n = 0;
    for (; s[n] != 0; n++) {}
    return n;
}

/** Compare strings lexicographically using unsigned byte values.
 * @param a First string.
 * @param b Second string.
 * @return Negative, zero, or positive when a is less than, equal to, or greater than b.
 */
export i32 cmp(char* a, char* b) {
    i32 i = 0;
    while (1) {
        i32 ca = (i32)a[i] & 0xFF;
        i32 cb = (i32)b[i] & 0xFF;
        if (ca != cb) {
            return ca - cb;
        }
        if (ca == 0) {
            return 0;
        }
        i++;
    }
}

/** Check whether two strings contain the same bytes.
 * @param a First string.
 * @param b Second string.
 * @return True when the strings are equal.
 */
export bool eq(char* a, char* b) {
    return cmp(a, b) == 0;
}

/** Compare at most n bytes using unsigned byte values.
 * @param a First string.
 * @param b Second string.
 * @param n Maximum number of bytes to compare.
 * @return Negative, zero, or positive according to lexicographic order.
 */
export i32 ncmp(char* a, char* b, i32 n) {
    i32 i = 0;
    while (i < n) {
        i32 ca = (i32)a[i] & 0xFF;
        i32 cb = (i32)b[i] & 0xFF;
        if (ca != cb) {
            return ca - cb;
        }
        if (ca == 0) {
            return 0;
        }
        i++;
    }
    return 0;
}

/** Check whether s begins with prefix.
 * @param s String to inspect.
 * @param prefix Prefix to match.
 * @return True when s starts with prefix.
 */
export bool starts_with(char* s, char* prefix) {
    i32 i = 0;
    while (prefix[i] != 0) {
        i32 cs = (i32)s[i] & 0xFF;
        i32 cp = (i32)prefix[i] & 0xFF;
        if (cs != cp) {
            return false;
        }
        i++;
    }
    return true;
}

/** Copy a NUL-terminated string, including its terminator.
 * @param dst Destination with room for len(src) + 1 bytes.
 * @param src Source string.
 * @return Number of non-terminator bytes copied.
 */
export i32 copy(char* dst, char* src) {
    i32 i = 0;
    while (src[i] != 0) {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return i;
}

/** Copy a string into a bounded destination and always terminate when cap is positive.
 * @param dst Destination buffer.
 * @param src Source string.
 * @param cap Destination capacity including the terminator.
 * @return Number of non-terminator bytes written; compare with len(src) to detect truncation.
 */
export i32 ncopy(char* dst, char* src, i32 cap) {
    if (cap <= 0) {
        return 0;
    }
    i32 i = 0;
    while (i < cap - 1) {
        if (src[i] == 0) {
            break;
        }
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return i;
}

/** Append src to dst, including a final terminator.
 * @param dst Destination with room for both strings and the terminator.
 * @param src String to append.
 * @return Resulting string length, excluding the terminator.
 */
export i32 cat(char* dst, char* src) {
    i32 n = len(dst);
    i32 i = 0;
    while (src[i] != 0) {
        dst[n + i] = src[i];
        i++;
    }
    dst[n + i] = 0;
    return n + i;
}

/** Find the first occurrence of a byte in a string.
 * @param s NUL-terminated string to search.
 * @param c Byte value to find; only its low 8 bits are used.
 * @return Byte index, or None when absent. Searching for zero returns the terminator index.
 */
export Option<i32> chr(char* s, i32 c) {
    i32 i = 0;
    i32 want = c & 0xFF;
    while (s[i] != 0) {
        if (((i32)s[i] & 0xFF) == want) {
            return Some(i);
        }
        i++;
    }
    if (want == 0) {
        return Some(i);
    }
    return None;
}

/** Find a substring.
 * @param haystack String to search.
 * @param needle Substring to find; an empty needle matches at index zero.
 * @return First matching byte index, or None when absent.
 */
export Option<i32> find(char* haystack, char* needle) {
    if (needle[0] == 0) {
        return Some(0);
    }
    i32 i = 0;
    while (haystack[i] != 0) {
        if (starts_with(&haystack[i], needle)) {
            return Some(i);
        }
        i++;
    }
    return None;
}

/** Convert a signed integer to a NUL-terminated decimal string.
 * @param value Integer to convert.
 * @param buf Destination with room for the result and terminator.
 * @return Number of characters written, excluding the terminator.
 */
export i32 itoa(i32 value, char* buf) {
    if (value == 0) {
        buf[0] = 48; // '0'
        buf[1] = 0;
        return 1;
    }

    i32 is_negative = 0;
    if (value < 0) {
        is_negative = 1;
        value = 0 - value;
    }

    // Count digits
    i32 temp = value;
    i32 num_digits = 0;
    while (temp > 0) {
        num_digits++;
        temp = temp / 10;
    }

    i32 total_chars = num_digits;
    if (is_negative) {
        total_chars++;
    }

    buf[total_chars] = 0;

    temp = value;
    i32 i = total_chars - 1;

    while (temp > 0) {
        i32 d = temp % 10;
        buf[i] = 48 + d; // '0' + d
        temp = temp / 10;
        i--;
    }

    if (is_negative) {
        buf[0] = 45; // '-'
    }

    return total_chars;
}

/** Convert an integer to lowercase hexadecimal without a prefix.
 * @param value Integer interpreted as a 32-bit value.
 * @param buf Destination with room for the result and terminator.
 * @return Number of characters written, excluding the terminator.
 */
export i32 xtoa(i32 value, char* buf) {
    if (value == 0) {
        buf[0] = 48; // '0'
        buf[1] = 0;
        return 1;
    }

    // Count nibbles, skipping leading zeros. Shifting right by 4 keeps this
    // free of the multiply and divide the target has no instruction for.
    i32 shift = 28;
    while (shift > 0) {
        if ((value >> shift) & 15) {
            break;
        }
        shift = shift - 4;
    }

    i32 n = 0;
    while (shift >= 0) {
        i32 nibble = (value >> shift) & 15;
        if (nibble < 10) {
            buf[n] = 48 + nibble;  // '0'
        } else {
            buf[n] = 87 + nibble;  // 'a' - 10
        }
        n++;
        shift = shift - 4;
    }
    buf[n] = 0;
    return n;
}

/** Parse a signed decimal prefix from a string.
 * Parsing stops at the first non-digit byte.
 * @param s String to parse; an optional leading plus or minus is accepted.
 * @return Parsed integer, or zero when no decimal digits follow the optional sign.
 */
export i32 atoi(char* s) {
    i32 i = 0;
    i32 sign = 1;

    if (s[0] == 45) {        // '-'
        sign = -1;
        i = 1;
    } else if (s[0] == 43) { // '+'
        i = 1;
    }

    i32 value = 0;
    while (1) {
        i32 c = (i32)s[i] & 0xFF;
        if (c < 48 || c > 57) {
            break;
        }
        // value * 10 as shifts: the target has no multiply instruction, so
        // codegen would otherwise expand this into a repeated-add loop.
        value = (value << 3) + (value << 1) + (c - 48);
        i++;
    }

    if (sign < 0) {
        return 0 - value;
    }
    return value;
}
