package annotations;

// The annotation metadata the compiler recorded, as an iterator over rows.
//
// `@name(args)` on a function or method is not a call: the compiler checks
// it against the imported prototype and writes one row into the module's
// `annotations` section (toolchain/MyLangCompiler/docs/grammar.md,
// "Attributes and annotations"). The linker joins every module's rows into
// one table, and this package walks it:
//
//     Annotations it = annotations.named("app");
//     while (it.next()) {
//         register(it.type(), it.size(), it.fn(), it.arg(0), it.text(1));
//     }
//
// What a row means is the reader's business -- the framework that declared
// the annotation. Rows of names a reader doesn't know are simply skipped.
//
// The same iterator reads the table of an executable image on disk
// (in_image): a shell can list what an app declares -- `@app(name = ...)`
// -- without loading it. The strings such rows point at are translated
// from the image's virtual addresses; fn() stays what it is, an address in
// the image's own space.

import { Slice } from "../memory/slice.mln";
import { as_slice } from "../memory/section.mln";
import { Option } from "../option.mln";
import mbin from "../format/mbin.mln";
import str from "../str.mln";

/** One annotation row, stored as eight 32-bit words.
 * @property name Annotation identifier.
 * @property fn Address of the annotated function in its image.
 * @property type Receiver type name, or empty for a free function.
 * @property size Receiver type size, or zero for a free function.
 * @property argc Number of recorded arguments after defaults are applied.
 * @property a0 First argument encoded as an integer, bool, or string address.
 * @property a1 Second argument encoded as an integer, bool, or string address.
 * @property a2 Third argument encoded as an integer, bool, or string address.
 */
export struct AnnotationRow {
    char *name;      // the annotation's name
    i32 fn;          // the annotated function
    char *type;      // receiver type's name; "" for a plain function
    i32 size;        // sizeof that type; 0 for a plain function
    i32 argc;        // arguments given (defaults filled in)
    i32 a0;          // the arguments: a number, a bool as 0/1, or a char* as i32
    i32 a1;
    i32 a2;
};

/** Iterator over annotation rows with optional name and receiver filters.
 * Call next() to advance, then use the accessors to read the current row.
 * @property rows Annotation rows being traversed.
 * @property index Index of the next row to examine.
 * @property want_name Name filter, or null for any name.
 * @property want_type Receiver-type filter, or null for any type.
 * @property cur Current row, or null before/after a successful iteration range.
 * @property image Source image for rows, or null for the running program.
 */
export struct Annotations {
    Slice<AnnotationRow> rows;
    i32 index;           // next row to examine
    char *want_name;     // 0: any
    char *want_type;     // 0: any
    AnnotationRow *cur;  // 0 before the first next() and after the last
    char *image;         // 0: the running program's table; else the MBIN image the rows live in
};

Annotations make(char *name, char *type) {
    return Annotations {
        rows: as_slice<AnnotationRow>("annotations"),
        index: 0,
        want_name: name,
        want_type: type,
        cur: (AnnotationRow*)0,
        image: (char*)0
    };
}

/** Read annotation rows from an MBIN image held in memory.
 * @param image MBIN file contents.
 * @return Iterator over its annotation rows; empty if the section is absent.
 */
export Annotations in_image(char *image) {
    i32 len = 0;
    AnnotationRow *data = (AnnotationRow*)0;
    case mbin.section_offset(image, "annotations") of {
        Some(off) -> ({
            case mbin.section_size(image, "annotations") of {
                Some(bytes) -> ({
                    data = (AnnotationRow*)(&image[off]);
                    len = bytes / sizeof(AnnotationRow);
                });
                None -> _;
            };
        });
        None -> _;
    };
    Slice<AnnotationRow> rows;
    rows.init(data, len);
    return Annotations {
        rows: rows,
        index: 0,
        want_name: (char*)0,
        want_type: (char*)0,
        cur: (AnnotationRow*)0,
        image: image
    };
}

/** Set filters and restart iteration.
 * @param name Annotation name, or null to accept any name.
 * @param type Receiver type, or null to accept any type.
 */
export void (Annotations *it) on(char *name, char *type) {
    it->want_name = name;
    it->want_type = type;
    it->index = 0;
    it->cur = (AnnotationRow*)0;
}

// A string the row points at, as a pointer this program can read.
char *string_of(Annotations *it, char *s) {
    if (it->image == 0) { return s; }
    if (s == 0) { return ""; }
    return case mbin.va_to_ptr(it->image, (i32)s) of {
        Some(p) -> p;
        None -> "";
    };
}

/** Iterate over every annotation in the linked table.
 * @return New unfiltered iterator.
 */
export Annotations all() { return make((char*)0, (char*)0); }

/** Iterate over rows with a given annotation name.
 * @param name Annotation name to match.
 * @return Iterator filtered by name.
 */
export Annotations named(char *name) { return make(name, (char*)0); }

/** Iterate over annotations attached to methods of a receiver type.
 * @param type Receiver type name to match.
 * @return Iterator filtered by receiver type.
 */
export Annotations of_type(char *type) { return make((char*)0, type); }

/** Iterate using both annotation-name and receiver-type filters.
 * @param name Annotation name, or null to accept any name.
 * @param type Receiver type, or null to accept any type.
 * @return Iterator matching both supplied filters.
 */
export Annotations where(char *name, char *type) { return make(name, type); }

/** Count rows in the running program's linked annotation table.
 * @return Total row count.
 */
export i32 count() {
    Slice<AnnotationRow> rows = as_slice<AnnotationRow>("annotations");
    return rows.len();
}

/** Advance to the next matching row.
 * @return True when a matching row was found, false at end.
 */
export bool (Annotations *it) next() {
    while (it->index < it->rows.len()) {
        AnnotationRow *r = it->rows.at(it->index);
        it->index++;
        if (it->want_name != 0 && !str.eq(string_of(it, r->name), it->want_name)) { continue; }
        if (it->want_type != 0 && !str.eq(string_of(it, r->type), it->want_type)) { continue; }
        it->cur = r;
        return true;
    }
    it->cur = (AnnotationRow*)0;
    return false;
}

/** Reset iteration to before the first row.
 */
export void (Annotations *it) reset() {
    it->index = 0;
    it->cur = (AnnotationRow*)0;
}

/** Get the current row.
 * @return Current row, or null when there is no current match.
 */
export AnnotationRow *(Annotations *it) row() { return it->cur; }

/** Get the current annotation name.
 * @return Annotation name, or an empty string when there is no current row.
 */
export char *(Annotations *it) name() { if (it->cur == 0) { return ""; } return string_of(it, it->cur->name); }
/** Get the current function address.
 * @return Function address, or zero when there is no current row.
 */
export i32 (Annotations *it) fn()      { if (it->cur == 0) { return 0; }  return it->cur->fn; }
/** Get the current receiver type name.
 * @return Type name, or an empty string for free functions/no current row.
 */
export char *(Annotations *it) type() { if (it->cur == 0) { return ""; } return string_of(it, it->cur->type); }
/** Get the current receiver type size.
 * @return Type size, or zero for free functions/no current row.
 */
export i32 (Annotations *it) size()    { if (it->cur == 0) { return 0; }  return it->cur->size; }
/** Get the current annotation's argument count.
 * @return Argument count, or zero when there is no current row.
 */
export i32 (Annotations *it) argc()    { if (it->cur == 0) { return 0; }  return it->cur->argc; }

/** Read a numeric or boolean argument.
 * @param k Argument index, from zero through two.
 * @return Stored integer value; zero for an invalid index or absent row.
 */
export i32 (Annotations *it) arg(i32 k) {
    if (it->cur == 0) { return 0; }
    if (k == 0) { return it->cur->a0; }
    if (k == 1) { return it->cur->a1; }
    if (k == 2) { return it->cur->a2; }
    return 0;
}

/** Read an argument as a string.
 * @param k Argument index, from zero through two.
 * @return String value, or an empty string when absent or not a string.
 */
export char *(Annotations *it) text(i32 k) {
    i32 v = it->arg(k);
    if (v == 0) { return ""; }
    return string_of(it, (char*)v);
}

/** Read an argument as a boolean flag.
 * @param k Argument index, from zero through two.
 * @return True when the stored value is non-zero.
 */
export bool (Annotations *it) flag(i32 k) {
    return it->arg(k) != 0;
}
