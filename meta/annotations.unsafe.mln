package annotations;

// The annotation metadata the compiler recorded, as an iterator over rows.
//
// `@name(args)` on a function, method or struct is not a call: the compiler checks
// it against the imported prototype and writes one row into the module's
// `annotations` section (toolchain/MyLangCompiler/docs/grammar.md,
// "Attributes and annotations"). The linker joins every module's rows into
// one table, and this package walks it:
//
//     Annotations it = annotations.named("app");
//     while (it.next()) {
//         // Read fields with Result after next() has selected a row.
//     }
//
// What a row means is the reader's business -- the framework that declared
// the annotation. Rows of names a reader doesn't know are simply skipped.
//
// The same iterator reads the table of an executable image on disk
// (in_image): a shell can list what an app declares -- `@app(name = ...)`
// -- without loading it. The strings such rows point at are translated
// from the image's virtual addresses; fn() stays what it is, an address in
// the image's own space.

import { Slice } from "@std/memory/slice.mln";
import { as_slice } from "@std/memory/section.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import { CodeAddress } from "@std/core/address.mln";
import mbin from "@std/format/mbin.mln";
import str from "@std/text/str.mln";
import { Text } from "@std/text/text.mln";

/** One annotation row, stored as seven 32-bit words.
 * @property name Annotation identifier.
 * @property fn Address of the annotated function in its image, 0 on a struct.
 * @property type Receiver type name, or empty for a free function.
 * @property argc Number of recorded arguments after defaults are applied.
 * @property a0 First argument encoded as an integer, bool, or string address.
 * @property a1 Second argument encoded as an integer, bool, or string address.
 * @property a2 Third argument encoded as an integer, bool, or string address.
 */
export struct AnnotationRow {
    char *name;      // the annotation's name
    CodeAddress fn;  // the annotated function; 0 on a struct
    char *type;      // receiver type's name; "" for a plain function
    i32 argc;        // arguments given (defaults filled in)
    i32 a0;          // the arguments: a number, a bool as 0/1, or a char* as i32
    i32 a1;
    i32 a2;
};

/** Iterator over annotation rows with optional name and receiver filters.
 * Call next() to advance, then use the accessors to read the current row.
 * @property rows Annotation rows being traversed.
 * @property index Index of the next row to examine.
 * @property want_name Name filter, or None for any name.
 * @property want_type Receiver-type filter, or None for any type.
 * @property cur Current row, or null before/after a successful iteration range.
 * @property image Source image for rows, or null for the running program.
 * @property image_size Size of the source image in bytes.
 */
export struct Annotations {
    Slice<AnnotationRow> rows;
    i32 index;           // next row to examine
    Option<Text<64>> want_name;
    Option<Text<64>> want_type;
    AnnotationRow *cur;  // 0 before the first next() and after the last
    char *image;         // 0: the running program's table; else the MBIN image the rows live in
    i32 image_size;
};

/** Failure while reading the current annotation row. */
export enum AnnotationError {
    NoCurrentRow,
    InvalidArgumentIndex(i32),
}

// An empty filter accepts everything; one too long for the row's strings
// stays a filter and matches nothing.
Option<Text<64>> filter_of(str text) {
    if (text.length == 0) { return None; }
    Text<64> filter = Text<64> {};
    filter.append(text);
    return Some(filter);
}

bool matches(Option<Text<64>> filter, str text) {
    return case filter of {
        Some(want) -> want.as_str() == text;
        None -> true;
    };
}

Annotations make(str name, str type) {
    return Annotations {
        rows: as_slice<AnnotationRow>("annotations"),
        index: 0,
        want_name: filter_of(name),
        want_type: filter_of(type),
        cur: (AnnotationRow*)0,
        image: (char*)0,
        image_size: 0
    };
}

/** Read annotation rows from an MBIN image held in memory.
 * @param image MBIN file contents, which must outlive the iterator.
 * @return Iterator over its annotation rows; empty if the section is absent.
 */
export Annotations in_image(str image) {
    i32 len = 0;
    AnnotationRow *data = (AnnotationRow*)0;
    case mbin.section_offset(image, "annotations") of {
        Some(off) -> ({
            case mbin.section_size(image, "annotations") of {
                Some(bytes) -> ({
                    data = (AnnotationRow*)(image.data + off);
                    len = bytes / sizeof(AnnotationRow);
                });
                None -> _;
            };
        });
        None -> _;
    };
    Slice<AnnotationRow> rows;
    rows.init(data, len);
    return Annotations {
        rows: rows,
        index: 0,
        want_name: filter_of(""),
        want_type: filter_of(""),
        cur: (AnnotationRow*)0,
        image: image.data,
        image_size: image.length
    };
}

/** Set filters and restart iteration.
 * @param name Annotation name, or "" to accept any name.
 * @param type Receiver type, or "" to accept any type.
 */
@safe
export void (borrow Annotations it) on(str name, str type) {
    it.want_name = filter_of(name);
    it.want_type = filter_of(type);
    it.index = 0;
    it.cur = (AnnotationRow*)0;
}

// A string the row points at, as a view this program can read.
str string_of(Annotations it, char *s) {
    if (s == 0) { return ""; }
    if (it.image == 0) { return str.from_c(s); }
    str image = str { data: it.image, length: it.image_size };
    return case mbin.string_at(image, (i32)s) of {
        Some(text) -> text;
        None -> "";
    };
}

/** Iterate over every annotation in the linked table.
 * @return New unfiltered iterator.
 */
@safe
export Annotations all() { return make("", ""); }

/** Iterate over rows with a given annotation name.
 * @param name Annotation name to match.
 * @return Iterator filtered by name.
 */
@safe
export Annotations named(str name) { return make(name, ""); }

/** Iterate over annotations attached to methods of a receiver type.
 * @param type Receiver type name to match.
 * @return Iterator filtered by receiver type.
 */
@safe
export Annotations of_type(str type) { return make("", type); }

/** Iterate using both annotation-name and receiver-type filters.
 * @param name Annotation name, or "" to accept any name.
 * @param type Receiver type, or "" to accept any type.
 * @return Iterator matching both supplied filters.
 */
@safe
export Annotations where(str name, str type) { return make(name, type); }

/** Count rows in the running program's linked annotation table.
 * @return Total row count.
 */
@safe
export i32 count() {
    Slice<AnnotationRow> rows = as_slice<AnnotationRow>("annotations");
    return rows.len();
}

/** Advance to the next matching row.
 * @return True when a matching row was found, false at end.
 */
@safe
export bool (borrow Annotations it) next() {
    Slice<AnnotationRow> rows = it.rows;
    while (it.index < rows.len()) {
        Option<borrow AnnotationRow> found = rows.at(it.index);
        borrow AnnotationRow r = case found of {
            Some(row) -> row;
            None -> ({ break; });
        };
        it.index++;
        if (!matches(it.want_name, string_of(it, r.name))) { continue; }
        if (!matches(it.want_type, string_of(it, r.type))) { continue; }
        it.cur = &r;
        return true;
    }
    it.cur = (AnnotationRow*)0;
    return false;
}

/** Reset iteration to before the first row.
 */
@safe
export void (borrow Annotations it) reset() {
    it.index = 0;
    it.cur = (AnnotationRow*)0;
}

/** Get the current row.
 * @return Some(current row), or None when there is no current match.
 */
export Option<AnnotationRow*> (Annotations it) row() {
    if (it.cur == 0) { return None; }
    return Some(it.cur);
}

/** Get the current annotation name.
 * @return Ok(annotation name), or Err(NoCurrentRow) when there is no current row.
 */
@safe
export Result<str, AnnotationError> (Annotations it) name() {
    if (it.cur == 0) { return Err(AnnotationError::NoCurrentRow); }
    return Ok(string_of(it, it.cur->name));
}
/** Get the current function address.
 * @return Ok(function address), or Err(NoCurrentRow) when there is no current row.
 */
@safe
export Result<CodeAddress, AnnotationError> (Annotations it) fn() {
    if (it.cur == 0) { return Err(AnnotationError::NoCurrentRow); }
    return Ok(it.cur->fn);
}
/** Get the current receiver type name.
 * @return Ok(type name), or Err(NoCurrentRow); free functions have an empty type name.
 */
@safe
export Result<str, AnnotationError> (Annotations it) type() {
    if (it.cur == 0) { return Err(AnnotationError::NoCurrentRow); }
    return Ok(string_of(it, it.cur->type));
}
/** Get the current annotation's argument count.
 * @return Ok(argument count), or Err(NoCurrentRow) when there is no current row.
 */
@safe
export Result<i32, AnnotationError> (Annotations it) argc() {
    if (it.cur == 0) { return Err(AnnotationError::NoCurrentRow); }
    return Ok(it.cur->argc);
}

/** Read a numeric or boolean argument.
 * @param k Valid argument index in the current row.
 * @return Ok(stored integer), or Err when the row/index is invalid.
 */
@safe
export Result<i32, AnnotationError> (Annotations it) arg(i32 k) {
    if (it.cur == 0) { return Err(AnnotationError::NoCurrentRow); }
    if (k < 0 || k >= it.cur->argc || k >= 3) { return Err(AnnotationError::InvalidArgumentIndex(k)); }
    if (k == 0) { return Ok(it.cur->a0); }
    if (k == 1) { return Ok(it.cur->a1); }
    return Ok(it.cur->a2);
}

/** Read an argument as a string.
 * @param k Valid argument index in the current row.
 * @return Ok(string value), or Err when the row/index is invalid.
 */
@safe
export Result<str, AnnotationError> (borrow Annotations it) text(i32 k) {
    Result<i32, AnnotationError> argument = it.arg(k);
    i32 v = argument?;
    if (v == 0) { return Ok(""); }
    return Ok(string_of(it, (char*)v));
}

/** Read an argument as a boolean flag.
 * @param k Valid argument index in the current row.
 * @return Ok(true) for a non-zero value, or Err when the row/index is invalid.
 */
@safe
export Result<bool, AnnotationError> (borrow Annotations it) flag(i32 k) {
    Result<i32, AnnotationError> argument = it.arg(k);
    i32 value = argument?;
    return Ok(value != 0);
}
