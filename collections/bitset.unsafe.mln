package bitset;

import { Option } from "@std/core/option.mln";
import bytes from "@std/text/bytes.mln";

// Bit array over a caller-owned byte buffer.
//
// Bit i lives in byte i/8 at bit i%8, LSB first — the layout the MFS block
// allocation bitmap (MyOS src/fs/fs.mln) and a page-frame allocator both want.
// The buffer is caller-owned; a set of n bits needs bytes(n) bytes.
//
// Indices are divided and masked with shifts, not `/` and `%`: the target has
// no divide instruction, so codegen would expand those into loops.

/** Calculate the storage size for a bit array.
 * @param n Number of bits required.
 * @return Number of bytes needed; n must be non-negative.
 */
@safe
export i32 bytes(i32 n) {
    return (n + 7) >> 3;
}

/** Read one bit.
 * @param bits Bit-array storage.
 * @param i Zero-based bit index.
 * @return True when the bit is set.
 */
export bool get(char* bits, i32 i) {
    i32 b = bytes.as_unsigned(bits[i >> 3]);
    return ((b >> (i & 7)) & 1) != 0;
}

/** Set one bit.
 * @param bits Bit-array storage.
 * @param i Zero-based bit index.
 */
export void set(char* bits, i32 i) {
    i32 off = i >> 3;
    i32 b = bytes.as_unsigned(bits[off]);
    bits[off] = b | (1 << (i & 7));
}

/** Clear one bit.
 * @param bits Bit-array storage.
 * @param i Zero-based bit index.
 */
export void clear(char* bits, i32 i) {
    i32 off = i >> 3;
    i32 b = bytes.as_unsigned(bits[off]);
    bits[off] = b & ~(1 << (i & 7));
}

/** Set or clear one bit based on value.
 * @param bits Bit-array storage.
 * @param i Zero-based bit index.
 * @param value True sets the bit; false clears it.
 */
export void put(char* bits, i32 i, bool value) {
    if (value) {
        set(bits, i);
    } else {
        clear(bits, i);
    }
}

/** Invert one bit.
 * @param bits Bit-array storage.
 * @param i Zero-based bit index.
 * @return True when the bit is now set.
 */
export bool toggle(char* bits, i32 i) {
    i32 off = i >> 3;
    i32 b = bytes.as_unsigned(bits[off]);
    b = b ^ (1 << (i & 7));
    bits[off] = b;
    return ((b >> (i & 7)) & 1) != 0;
}

/** Find a clear bit at or after start, limited to indices below n.
 * @param bits Bit-array storage.
 * @param n Number of valid bits in the array.
 * @param start First index to inspect; negative values are treated as zero.
 * @return First clear-bit index, or None if no clear bit remains.
 */
export Option<i32> find_clear(char* bits, i32 n, i32 start) {
    i32 i = start;
    if (i < 0) {
        i = 0;
    }

    while (i < n) {
        if ((i & 7) == 0) {
            while (i + 8 <= n) {
                if (bytes.as_unsigned(bits[i >> 3]) != 0xFF) {
                    break;
                }
                i = i + 8;
            }
            if (i >= n) {
                return None;
            }
        }
        if (!get(bits, i)) {
            return Some(i);
        }
        i++;
    }
    return None;
}

/** Find a set bit at or after start, limited to indices below n.
 * @param bits Bit-array storage.
 * @param n Number of valid bits in the array.
 * @param start First index to inspect; negative values are treated as zero.
 * @return First set-bit index, or None if no set bit remains.
 */
export Option<i32> find_set(char* bits, i32 n, i32 start) {
    i32 i = start;
    if (i < 0) {
        i = 0;
    }

    while (i < n) {
        if ((i & 7) == 0) {
            while (i + 8 <= n) {
                if (bytes.as_unsigned(bits[i >> 3])) {
                    break;
                }
                i = i + 8;
            }
            if (i >= n) {
                return None;
            }
        }
        if (get(bits, i)) {
            return Some(i);
        }
        i++;
    }
    return None;
}

/** Count set bits in the range [0, n).
 * @param bits Bit-array storage.
 * @param n Number of bits to inspect.
 * @return Number of set bits in the range.
 */
export i32 count(char* bits, i32 n) {
    i32 total = 0;
    i32 i = 0;
    while (i < n) {
        total = total + get(bits, i);
        i++;
    }
    return total;
}

/** Clear the first n bits.
 * @param bits Bit-array storage.
 * @param n Number of bits to clear.
 */
export void clear_all(char* bits, i32 n) {
    i32 nbytes = bytes(n);
    i32 i = 0;
    while (i < nbytes) {
        bits[i] = 0;
        i++;
    }
}
