// Fixed-capacity string-keyed map. Keys are borrowed NUL-terminated strings;
// capacity must be a power of two. Deletion and automatic growth are omitted.
//
//     HashMap<i32> m;
//     m.init(keys, values, 8);
//     m.put("answer", 42);
//     i32 v;
//     if (m.get("answer", &v)) { ... }
export struct HashMap<T> {
    i32 *keys;
    T *values;
    i32 cap;
    i32 len;
};

export void (HashMap<T> *map) init(i32 *keys, T *values, i32 cap) {
    map->keys = keys;
    map->values = values;
    map->len = 0;
    if (cap <= 0 || (cap & (cap - 1)) != 0) {
        map->cap = 0;
        return;
    }
    map->cap = cap;
    i32 i = 0;
    while (i < cap) {
        keys[i] = 0;
        i = i + 1;
    }
}

export bool (HashMap<T> *map) put(char *key, T value) {
    if (map->cap <= 0) {
        return false;
    }
    i32 hash = 5381;
    i32 index = 0;
    while (key[index] != 0) {
        hash = (hash * 33) + ((i32)key[index] & 0xFF);
        index++;
    }
    i32 slot = hash & (map->cap - 1);
    i32 *keys = map->keys;
    T *values = map->values;
    i32 checked = 0;
    while (checked < map->cap) {
        char *existing = (char *)keys[slot];
        if (existing == (char *)0) {
            keys[slot] = (i32)key;
            values[slot] = value;
            map->len++;
            return true;
        }
        bool equal = true;
        index = 0;
        while (existing[index] != 0 || key[index] != 0) {
            if (existing[index] != key[index]) {
                equal = false;
                break;
            }
            index++;
        }
        if (equal) {
            values[slot] = value;
            return true;
        }
        slot = slot + 1;
        if (slot >= map->cap) {
            slot = 0;
        }
        checked++;
    }
    return false;
}

export bool (HashMap<T> *map) get(char *key, T *out) {
    if (map->cap <= 0) {
        return false;
    }
    i32 hash = 5381;
    i32 index = 0;
    while (key[index] != 0) {
        hash = (hash * 33) + ((i32)key[index] & 0xFF);
        index++;
    }
    i32 slot = hash & (map->cap - 1);
    i32 *keys = map->keys;
    T *values = map->values;
    i32 checked = 0;
    while (checked < map->cap) {
        char *existing = (char *)keys[slot];
        if (existing == (char *)0) {
            return false;
        }
        bool equal = true;
        index = 0;
        while (existing[index] != 0 || key[index] != 0) {
            if (existing[index] != key[index]) {
                equal = false;
                break;
            }
            index++;
        }
        if (equal) {
            *out = values[slot];
            return true;
        }
        slot = slot + 1;
        if (slot >= map->cap) {
            slot = 0;
        }
        checked++;
    }
    return false;
}
