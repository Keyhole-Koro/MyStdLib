// Fixed-capacity FIFO over caller-owned storage. One slot remains empty to
// distinguish full from empty, so usable capacity is `cap - 1`.
//
//     RingBuffer<char> r;
//     r.init(storage, 64);
//     r.push('a');          // false when full
//     char c;
//     if (r.pop(&c)) { ... }
export struct RingBuffer<T> {
    T *data;
    i32 cap;
    i32 head;
    i32 tail;
};

export void (RingBuffer<T> *r) init(T *storage, i32 cap) {
    r->data = storage;
    r->cap = cap;
    r->head = 0;
    r->tail = 0;
}

export i32 (RingBuffer<T> *r) capacity() {
    return r->cap - 1;
}

export i32 (RingBuffer<T> *r) count() {
    if (r->tail >= r->head) {
        return r->tail - r->head;
    }
    return r->cap - r->head + r->tail;
}

export bool (RingBuffer<T> *r) has() {
    if (r->head == r->tail) {
        return false;
    }
    return true;
}

export bool (RingBuffer<T> *r) full() {
    i32 next = r->tail + 1;
    if (next >= r->cap) {
        next = 0;
    }
    if (next == r->head) {
        return true;
    }
    return false;
}

export bool (RingBuffer<T> *r) push(T value) {
    i32 next = r->tail + 1;
    if (next >= r->cap) {
        next = 0;
    }
    if (next == r->head) {
        return false;
    }
    T *data = r->data;
    data[r->tail] = value;
    r->tail = next;
    return true;
}

export bool (RingBuffer<T> *r) pop(T *out) {
    if (r->head == r->tail) {
        return false;
    }
    T *data = r->data;
    *out = data[r->head];
    r->head = r->head + 1;
    if (r->head >= r->cap) {
        r->head = 0;
    }
    return true;
}

// Read the oldest value without removing it. Leaves *out untouched when empty.
export bool (RingBuffer<T> *r) peek(T *out) {
    if (r->head == r->tail) {
        return false;
    }
    T *data = r->data;
    *out = data[r->head];
    return true;
}

// Discard every queued value.
export void (RingBuffer<T> *r) clear() {
    r->head = 0;
    r->tail = 0;
}
