import { SliceIter } from "@std/memory/slice.mln";
import { Option } from "@std/core/option.mln";

/** Fixed-capacity vector over caller-owned storage.
 * @property data Pointer to caller-owned element storage.
 * @property len Number of initialized elements.
 * @property cap Number of available storage slots.
 */
//
//     Vec<i32> v;
//     v.init(storage, 8);
//     v.push(3);            // false when full
//     case v.at(0) of { Some(p) -> ...; None -> ...; }   // None when out of range
export struct Vec<T> {
    T *data;
    i32 len;
    i32 cap;
};

/** Initialize an empty vector over caller-owned storage.
 * @param storage Storage for at least cap elements.
 * @param cap Number of available elements in storage.
 */
export void (borrow mut Vec<T> v) init(T *storage, i32 cap) {
    v.data = storage;
    v.len = 0;
    v.cap = cap;
}

/** Return the number of elements currently stored.
 * @return Current element count.
 */
@safe
export i32 (borrow Vec<T> v) len() {
    return v.len;
}

/** Append value to the end of the vector.
 * @param value Element to append.
 * @return True if appended, false if the vector is full.
 */
@safe
export bool (borrow mut Vec<T> v) push(T value) {
    if (v.len >= v.cap) {
        return false;
    }
    T *data = v.data;
    data[v.len] = value;
    v.len++;
    return true;
}

/** Remove the last element and copy it to out.
 * @param out Destination for the removed element; unchanged when empty.
 * @return True if an element was removed, false if empty.
 */
export bool (borrow mut Vec<T> v) pop(T *out) {
    if (v.len == 0) {
        return false;
    }
    v.len--;
    T *data = v.data;
    *out = data[v.len];
    return true;
}

/** Find an element by zero-based index. The vector stays borrowed while
 * the result is in scope.
 * @param index Element index.
 * @return A borrow of the element, or None when index is out of range.
 */
@safe
export Option<borrow T> (borrow Vec<T> v) at(i32 index) {
    if (index < 0 || index >= v.len) {
        return None;
    }
    return Some(&v.data[index]);
}

/** Like at(), but the element can be written through the result. The
 * vector stays mutably borrowed while the result is in scope.
 * @param index Element index.
 * @return A mutable borrow of the element, or None when out of range.
 */
@safe
export Option<borrow mut T> (borrow mut Vec<T> v) at_mut(i32 index) {
    if (index < 0 || index >= v.len) {
        return None;
    }
    return Some(&mut v.data[index]);
}

/** An iterator over the stored elements, front to back, yielding pointers. */
@safe
export SliceIter<T> (borrow Vec<T> v) iter() {
    return SliceIter<T> { cursor: v.data, left: v.len };
}
