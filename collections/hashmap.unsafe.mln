import { Eq } from "@std/core/cmp.mln";
import { Hash } from "@std/core/hash.mln";
import { Option } from "@std/core/option.mln";
import { Iterator } from "@std/core/iter.mln";

/** Fixed-capacity open-addressed map over caller-owned storage.
 *
 * Capacity must be a positive power of two. `used` is a caller-owned byte
 * array with one entry per key slot; it is separate from `keys` so every
 * value of K, including zero and null-like values, remains a valid key.
 * Deletion and automatic growth are intentionally omitted.
 */
//
//     Pid keys[8];
//     Process* values[8];
//     u8 used[8];
//     HashMap<Pid, Process*> processes;
//     processes.init(&keys[0], &values[0], &used[0], 8);
//     processes.put(pid, process);
export struct HashMap<K, V> {
    K *keys;
    V *values;
    u8 *used;
    i32 cap;
    i32 len;
};

/* Keep Hash's pointer receiver at this ordinary generic-function boundary.
 * A generic receiver method cannot yet auto-borrow one of its own value
 * parameters for a trait method, whereas a specialized generic function can. */
export u32 hash_key<K: Hash>(K *key) {
    return key.hash();
}

/** Initialize the map using caller-owned key, value, and occupancy arrays. */
export void (borrow HashMap<K, V> map) init<K, V>(K *keys, V *values, u8 *used, i32 cap) {
    map.keys = keys;
    map.values = values;
    map.used = used;
    map.len = 0;
    if (cap <= 0 || (cap & (cap - 1))) {
        map.cap = 0;
        return;
    }
    map.cap = cap;
    i32 i = 0;
    while (i < cap) {
        used[i] = 0;
        i++;
    }
}

/** Insert a key/value pair or replace the value for an existing key.
 * @return True on insertion or replacement, false if disabled or full.
 */
@safe
export bool (borrow HashMap<K, V> map) put<K: Hash + Eq, V>(move K key, move V value) {
    if (map.cap <= 0) { return false; }
    i32 slot = (i32)(hash_key<K>(&key) & (u32)(map.cap - 1));
    i32 checked = 0;
    while (checked < map.cap) {
        if (map.used[slot] != 0 && map.keys[slot] == key) {
            map.values[slot] = value;
            return true;
        }
        if (map.used[slot] == 0) {
            map.used[slot] = 1;
            map.keys[slot] = key;
            map.values[slot] = value;
            map.len++;
            return true;
        }
        slot = slot + 1;
        if (slot >= map.cap) { slot = 0; }
        checked++;
    }
    return false;
}

/** The value stored for `key`, or None when the key is absent:
 * `*map.get(&k).unwrap_or(&fallback)`, or `?` in a function returning
 * Option. The map stays borrowed while the result is in scope.
 */
export Option<borrow V> (borrow HashMap<K, V> map) get<K: Hash + Eq, V>(K *key) {
    i32 slot = map.slot_of(key);
    if (slot < 0) { return None; }
    return Some(&map.values[slot]);
}

/** The slot holding `key`, or -1 when the key is absent. */
export i32 (HashMap<K, V> map) slot_of<K: Hash + Eq, V>(K *key) {
    if (map.cap <= 0) { return -1; }
    i32 slot = (i32)(hash_key<K>(key) & (u32)(map.cap - 1));
    i32 checked = 0;
    while (checked < map.cap) {
        if (map.used[slot] == 0) { return -1; }
        if (map.keys[slot] == *key) { return slot; }
        slot = slot + 1;
        if (slot >= map.cap) { slot = 0; }
        checked++;
    }
    return -1;
}

/** One stored pair, borrowed from the map's storage. */
export struct MapEntry<K, V> {
    K *key;
    V *value;
};

/** Walks the stored pairs in slot order:
 *
 *     for (MapEntry<i32, i32> e in map.entries()) { total = total + *e.value; }
 */
export struct MapEntries<K, V> {
    HashMap<K, V> *map;
    i32 slot;
};

@safe
export impl<K, V> Iterator<MapEntry<K, V>> for MapEntries<K, V> {
    Option<MapEntry<K, V>> (borrow Self self) next() {
        HashMap<K, V> *map = self.map;
        while (self.slot < map->cap) {
            i32 slot = self.slot;
            self.slot = slot + 1;
            if (map->used[slot] != 0) {
                return Some(MapEntry<K, V> { key: map->keys + slot, value: map->values + slot });
            }
        }
        return None;
    }
}

/** An iterator over the stored key/value pairs. */
@safe
export MapEntries<K, V> (borrow HashMap<K, V> map) entries() {
    return MapEntries<K, V> { map: map, slot: 0 };
}
