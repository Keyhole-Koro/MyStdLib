// A singly linked intrusive list. The payload type owns its next link; callers
// pass the address of that field (for example, `&node->next`).
//
//     IntrusiveList<Node> l;
//     l.init();
//     l.push_front(n, &n->next);
//     Node *first = l.pop_front(&l.head->next);
export struct IntrusiveList<T> {
    T *head;
    i32 len;
};

export void (IntrusiveList<T> *list) init() {
    list->head = (T *)0;
    list->len = 0;
}

export void (IntrusiveList<T> *list) push_front(T *node, T **node_next) {
    *node_next = list->head;
    list->head = node;
    list->len = list->len + 1;
}

export T *(IntrusiveList<T> *list) pop_front(T **head_next) {
    T *node = list->head;
    if (node == 0) {
        return (T *)0;
    }
    list->head = *head_next;
    *head_next = (T *)0;
    list->len = list->len - 1;
    return node;
}
