package mbin;

// Reading an MBIN executable image from a buffer -- a file loaded from
// disk, not a mapped process (toolchain/MyLinker/inc/ObjectFormat.h,
// docs/design/mbin-executable-header.md).
//
//     str image = ...;                         // the whole file
//     if (mbin.is_image(image)) {
//         Option<i32> off = mbin.section_offset(image, "annotations");
//         Option<i32> len = mbin.section_size(image, "annotations");
//     }
//
// The header's section directory (version 2) is the linker's `__sections`
// table: [name (char*), start, size] rows ending in a zero row, with the
// name strings after it. Its addresses are virtual -- where the image runs
// -- so to read anything it names from the file, translate with
// va_to_offset(): text is mapped at entry & ~0xFFF, data at the page after
// the text, which is what the kernel loader does too.
//
// Every read goes through the view, so a damaged image reads as zeros past
// its end rather than reaching other memory.

import str from "@std/text/str.mln";
import { Option } from "@std/core/option.mln";

i32 MAGIC = 0x4D42494E;   // 'MBIN'

i32 be32(str image, i32 at) {
    i32 b0 = image.byte(at);
    i32 b1 = image.byte(at + 1);
    i32 b2 = image.byte(at + 2);
    i32 b3 = image.byte(at + 3);
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

i32 page_up(i32 v) {
    i32 rem = v & 4095;
    if (rem == 0) { return v; }
    return (v - rem) + 4096;
}

/** Check whether a buffer begins with an MBIN header.
 * @param image Buffer containing the candidate executable.
 * @return True when the buffer is large enough and has the MBIN magic.
 */
export bool is_image(str image) {
    if (image.length < 32) { return false; }
    return be32(image, 0) == MAGIC;
}

/** Read the MBIN format version.
 * @param image MBIN image buffer.
 * @return Header version.
 */
export i32 version(str image)      { return be32(image, 4); }
/** Read the executable entry virtual address.
 * @param image MBIN image buffer.
 * @return Entry virtual address.
 */
export i32 entry(str image)        { return be32(image, 8); }
/** Read the text segment file offset.
 * @param image MBIN image buffer.
 * @return Text segment offset within the file.
 */
export i32 text_offset(str image)  { return be32(image, 12); }
/** Read the text segment size.
 * @param image MBIN image buffer.
 * @return Text segment size in bytes.
 */
export i32 text_size(str image)    { return be32(image, 16); }
/** Read the data segment file offset.
 * @param image MBIN image buffer.
 * @return Data segment offset within the file.
 */
export i32 data_offset(str image)  { return be32(image, 20); }
/** Read the data segment size.
 * @param image MBIN image buffer.
 * @return Data segment size in bytes.
 */
export i32 data_size(str image)    { return be32(image, 24); }
/** Read the zero-initialized data size.
 * @param image MBIN image buffer.
 * @return BSS size in bytes.
 */
export i32 bss_size(str image)     { return be32(image, 28); }

/** Find the section-directory file offset.
 * @param image MBIN image buffer.
 * @return Directory file offset, or None when no directory is present.
 */
export Option<i32> sections_offset(str image) {
    if (version(image) < 2) { return None; }
    i32 off = be32(image, 32);
    if (off == 0) { return None; }
    return Some(off);
}

/** Calculate the text segment's load address.
 * @param image MBIN image buffer.
 * @return Page-aligned text virtual address.
 */
export i32 text_vaddr(str image) { return entry(image) & 0xFFFFF000; }

/** Calculate the data segment's load address.
 * @param image MBIN image buffer.
 * @return Virtual address immediately following the page-aligned text segment.
 */
export i32 data_vaddr(str image) { return text_vaddr(image) + page_up(text_size(image)); }

/** Translate a loaded virtual address to a file offset.
 * @param image MBIN image buffer.
 * @param va Virtual address to translate.
 * @return File offset, or None when va lies outside text and data segments.
 */
export Option<i32> va_to_offset(str image, i32 va) {
    i32 tv = text_vaddr(image);
    i32 ts = text_size(image);
    if (va >= tv && va < tv + ts) { return Some(text_offset(image) + (va - tv)); }
    i32 dv = data_vaddr(image);
    i32 ds = data_size(image);
    if (va >= dv && va < dv + ds) { return Some(data_offset(image) + (va - dv)); }
    return None;
}

/** Read the NUL-terminated string at a loaded virtual address.
 * @param image MBIN image buffer.
 * @param va Virtual address of the first byte.
 * @return View into image, or None when va is outside the image.
 */
export Option<str> string_at(str image, i32 va) {
    i32 start = case va_to_offset(image, va) of {
        Some(offset) -> offset;
        None -> ({ return None; });
    };
    i32 end = start;
    while (end < image.length && image.byte(end) != 0) { end++; }
    return image.slice(start, end);
}

// Directory row of the section called `name`, or None.
Option<i32> find_row(str image, str name) {
    i32 row = case sections_offset(image) of {
        Some(v) -> v;
        None -> ({ return None; });
    };
    while (be32(image, row) != 0) {
        Option<str> candidate = string_at(image, be32(image, row));
        case candidate of {
            Some(found) -> ({ if (found == name) { return Some(row); } });
            None -> _;
        };
        row = row + 12;
    }
    return None;
}

/** Find a section's first byte in the file.
 * @param image MBIN image buffer.
 * @param name Section name.
 * @return File offset, or None when the section is absent or unmapped.
 */
export Option<i32> section_offset(str image, str name) {
    i32 row = case find_row(image, name) of {
        Some(v) -> v;
        None -> ({ return None; });
    };
    return va_to_offset(image, be32(image, row + 4));
}

/** Read a section's byte size.
 * @param image MBIN image buffer.
 * @param name Section name.
 * @return Section size, or None when the section is absent.
 */
export Option<i32> section_size(str image, str name) {
    i32 row = case find_row(image, name) of {
        Some(v) -> v;
        None -> ({ return None; });
    };
    return Some(be32(image, row + 8));
}
