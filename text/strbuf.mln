package strbuf;

import str from "../str.mln";

// Append-only string builder over a caller-owned char array.
//
// This compatibility API keeps state explicit: every call takes the buffer,
// its capacity and the current length, and returns the new length.
//
//   char line[64];
//   i32 n = strbuf.reset(&line[0]);
//   n = strbuf.append(&line[0], 64, n, "clicks: ");
//   n = strbuf.append_i32(&line[0], 64, n, clicks);
//
// `cap` counts the terminator, so a char[64] holds 63 visible bytes. Every
// function keeps the buffer NUL-terminated and silently truncates rather than
// overrunning; a caller that must detect truncation compares the returned
// length against what it appended.


/** Clear the string buffer.
 * @param buf Buffer to clear; it must have at least one byte.
 * @return New length, always zero.
 */
export i32 reset(char* buf) {
    buf[0] = 0;
    return 0;
}

/** Compute remaining visible capacity before truncation.
 * @param cap Buffer capacity including space for the terminator.
 * @param len Current visible string length.
 * @return Remaining appendable bytes, or zero when no space remains.
 */
export i32 space(i32 cap, i32 len) {
    i32 left = cap - 1 - len;
    if (left < 0) {
        return 0;
    }
    return left;
}

// Append one byte. Returns the new length.
/** Append one byte to the string buffer.
 * @param buf Destination buffer.
 * @param cap Capacity including the terminator slot.
 * @param len Current string length.
 * @param c Byte value to append; only its low 8 bits are used.
 * @return New string length; unchanged when full.
 */
export i32 push(char* buf, i32 cap, i32 len, i32 c) {
    if (len >= cap - 1) {
        return len;
    }
    buf[len] = c & 0xFF;
    buf[len + 1] = 0;
    return len + 1;
}

// Append a NUL-terminated string, truncating at capacity.
// Returns the new length.
/** Append a NUL-terminated string, truncating when the buffer fills.
 * @param buf Destination buffer.
 * @param cap Capacity including the terminator slot.
 * @param len Current string length.
 * @param s NUL-terminated source string.
 * @return New string length.
 */
export i32 append(char* buf, i32 cap, i32 len, char* s) {
    i32 n = len;
    i32 i = 0;
    while (s[i] != 0) {
        if (n >= cap - 1) {
            break;
        }
        buf[n] = s[i];
        n = n + 1;
        i++;
    }
    buf[n] = 0;
    return n;
}

// Append at most `max` bytes of s. Returns the new length.
/** Append up to max bytes from s, truncating when the buffer fills.
 * @param buf Destination buffer.
 * @param cap Capacity including the terminator slot.
 * @param len Current string length.
 * @param s Source string.
 * @param max Maximum number of source bytes to append.
 * @return New string length.
 */
export i32 append_n(char* buf, i32 cap, i32 len, char* s, i32 max) {
    i32 n = len;
    i32 i = 0;
    while (i < max) {
        if (s[i] == 0) {
            break;
        }
        if (n >= cap - 1) {
            break;
        }
        buf[n] = s[i];
        n = n + 1;
        i++;
    }
    buf[n] = 0;
    return n;
}

// Append value in base 10. Returns the new length.
/** Append an integer in decimal notation.
 * @param buf Destination buffer.
 * @param cap Capacity including the terminator slot.
 * @param len Current string length.
 * @param value Integer to append.
 * @return New string length.
 */
export i32 append_i32(char* buf, i32 cap, i32 len, i32 value) {
    char tmp[12];
    str.itoa(value, &tmp[0]);
    return append(buf, cap, len, &tmp[0]);
}

// Append value in base 16, lowercase and unprefixed. Returns the new length.
/** Append an integer in lowercase hexadecimal without a prefix.
 * @param buf Destination buffer.
 * @param cap Capacity including the terminator slot.
 * @param len Current string length.
 * @param value Integer to append.
 * @return New string length.
 */
export i32 append_hex(char* buf, i32 cap, i32 len, i32 value) {
    char tmp[12];
    str.xtoa(value, &tmp[0]);
    return append(buf, cap, len, &tmp[0]);
}

// Append the same byte n times, e.g. to pad a column. Returns the new length.
/** Append the same byte up to n times or until the buffer fills.
 * @param buf Destination buffer.
 * @param cap Capacity including the terminator slot.
 * @param len Current string length.
 * @param c Byte value to append; only its low 8 bits are used.
 * @param n Maximum repetition count.
 * @return New string length.
 */
export i32 append_repeat(char* buf, i32 cap, i32 len, i32 c, i32 n) {
    i32 written = len;
    i32 i = 0;
    while (i < n) {
        if (written >= cap - 1) {
            break;
        }
        buf[written] = c & 0xFF;
        written = written + 1;
        i++;
    }
    buf[written] = 0;
    return written;
}

// Drop the last n bytes. Returns the new length.
/** Remove up to n trailing bytes from the string.
 * @param buf String buffer to truncate.
 * @param len Current string length.
 * @param n Number of trailing bytes to remove.
 * @return New string length, clamped to zero.
 */
export i32 truncate(char* buf, i32 len, i32 n) {
    i32 kept = len - n;
    if (kept < 0) {
        kept = 0;
    }
    buf[kept] = 0;
    return kept;
}
