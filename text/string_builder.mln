package string_builder;

/** Mutable string builder over caller-owned storage.
 *
 * Capacity includes the trailing NUL slot. The builder never allocates and
 * never owns `data`. Appending more bytes than fit writes the available prefix
 * and returns false; the buffer remains NUL-terminated when capacity is
 * positive.
 *
 * @property data Caller-owned byte storage.
 * @property length Number of logical bytes currently stored.
 * @property capacity Storage size including the trailing NUL slot.
 */
export struct StringBuilder {
    char *data;
    i32 length;
    i32 capacity;
};

/** Initialize an empty builder over caller-owned storage.
 * @param storage Destination storage.
 * @param capacity Storage size including the trailing NUL slot.
 */
export void (StringBuilder *self) init(char *storage, i32 capacity) {
    self->data = storage;
    self->length = 0;
    self->capacity = capacity;
    if (self->capacity < 0) { self->capacity = 0; }
    if (self->capacity > 0) { self->data[0] = 0; }
}

/** Return the number of logical bytes in the builder.
 * @return Byte length.
 */
export i32 (StringBuilder *self) len() {
    return self->length;
}

/** Return the number of additional bytes that fit without truncation.
 * @return Remaining byte capacity, excluding the NUL slot.
 */
export i32 (StringBuilder *self) remaining() {
    i32 available = self->capacity - 1 - self->length;
    if (available < 0) { return 0; }
    return available;
}

/** Test whether the builder contains no bytes.
 * @return True when len() is zero.
 */
export bool (StringBuilder *self) is_empty() {
    return self->length == 0;
}

/** Remove all content without releasing the caller-owned storage. */
export void (StringBuilder *self) clear() {
    self->length = 0;
    if (self->capacity > 0) { self->data[0] = 0; }
}

/** Append a string view.
 * @param value Bytes to append; embedded NUL bytes are preserved.
 * @return True when all bytes fit, false when only a prefix was appended.
 */
export bool (StringBuilder *self) append(str value) {
    i32 count = value.length;
    i32 available = self.remaining();
    bool complete = true;
    if (count > available) {
        count = available;
        complete = false;
    }
    i32 i = 0;
    while (i < count) {
        self->data[self->length + i] = value.data[i];
        i++;
    }
    self->length = self->length + count;
    if (self->capacity > 0) { self->data[self->length] = 0; }
    return complete;
}

/** Append one byte.
 * @param value Byte to append.
 * @return True when the byte fit, false when the builder was full.
 */
export bool (StringBuilder *self) push(u8 value) {
    if (self.remaining() == 0) { return false; }
    self->data[self->length] = (char)value;
    self->length++;
    self->data[self->length] = 0;
    return true;
}

/** Shorten the builder to at most `length` bytes.
 * @param length New maximum length; negative values clamp to zero.
 */
export void (StringBuilder *self) truncate(i32 length) {
    if (length < 0) { length = 0; }
    if (length < self->length) { self->length = length; }
    if (self->capacity > 0) { self->data[self->length] = 0; }
}

/** Borrow the current contents as a length-aware string view.
 * @return View valid while the caller-owned storage remains valid.
 */
export str (StringBuilder *self) as_str() {
    return str { data: self->data, length: self->length };
}
