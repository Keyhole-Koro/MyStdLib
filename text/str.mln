package str;

import { Option } from "../core/option.mln";
import { InlineString } from "inline_string.mln";

// `str` is MyLang's borrowed, length-aware string view. Its layout is owned
// by the language (`char* data`, `i32 length`); this module supplies the
// algorithms and the bridge to legacy NUL-terminated APIs.

/** Build a string view by measuring a legacy NUL-terminated string.
 * @param data NUL-terminated byte string.
 * @return Borrowed view over data, excluding the terminator.
 */
export str from_c(char* data) {
    return str { data: data, length: len(data) };
}

/** Convert a legacy NUL-terminated pointer to a length-aware view.
 * @return Borrowed view over self.
 */
export str (char* self) as_str() {
    return from_c(self);
}

/** Return the number of bytes in this string view.
 * @return Byte length; this does not scan for a terminator.
 */
export i32 (str self) len() {
    return self.length;
}

/** Test whether this view contains no bytes.
 * @return True when len() is zero.
 */
export bool (str self) is_empty() {
    return self.length == 0;
}

/** Access the underlying pointer for a legacy C-style API.
 * @return Pointer to the first byte. A sliced view is not guaranteed to end
 * at its logical length, so callers must not assume a terminator there.
 */
export char* (str self) as_c_str() {
    return self.data;
}

/** Compare two views lexicographically using unsigned byte values.
 * @param other View to compare with self.
 * @return Negative, zero, or positive according to byte order.
 */
export i32 (str self) compare(str other) {
    i32 n = self.length;
    if (other.length < n) { n = other.length; }
    i32 i = 0;
    while (i < n) {
        i32 a = (i32)self.data[i] & 0xFF;
        i32 b = (i32)other.data[i] & 0xFF;
        if (a != b) { return a - b; }
        i++;
    }
    return self.length - other.length;
}

/** Test whether self begins with prefix.
 * @param prefix Prefix to match.
 * @return True when every prefix byte matches.
 */
export bool (str self) starts_with(str prefix) {
    if (prefix.length > self.length) { return false; }
    i32 i = 0;
    while (i < prefix.length) {
        if (self.data[i] != prefix.data[i]) { return false; }
        i++;
    }
    return true;
}

/** Test whether self ends with suffix.
 * @param suffix Suffix to match.
 * @return True when every suffix byte matches.
 */
export bool (str self) ends_with(str suffix) {
    if (suffix.length > self.length) { return false; }
    i32 start = self.length - suffix.length;
    i32 i = 0;
    while (i < suffix.length) {
        if (self.data[start + i] != suffix.data[i]) { return false; }
        i++;
    }
    return true;
}

/** Find the first occurrence of needle in self.
 * @param needle Substring to find; an empty view matches at zero.
 * @return First byte index, or None when absent.
 */
export Option<i32> (str self) find(str needle) {
    if (needle.length == 0) { return Some(0); }
    if (needle.length > self.length) { return None; }
    i32 at = 0;
    while (at <= self.length - needle.length) {
        i32 i = 0;
        while (i < needle.length && self.data[at + i] == needle.data[i]) { i++; }
        if (i == needle.length) { return Some(at); }
        at++;
    }
    return None;
}

/** Borrow an end-exclusive subrange.
 * @param start First byte index.
 * @param end End-exclusive byte index.
 * @return The requested view, or None for an invalid range.
 */
export Option<str> (str self) slice(i32 start, i32 end) {
    if (start < 0 || end < start || end > self.length) { return None; }
    return Some(str { data: self.data + start, length: end - start });
}

/** Read one byte without unchecked indexing.
 * @param index Byte index.
 * @return The byte, or None when index is outside the view.
 */
export Option<u8> (str self) byte_at(i32 index) {
    if (index < 0 || index >= self.length) { return None; }
    return Some((u8)self.data[index]);
}

// Legacy NUL-terminated byte string helpers. The language-level `str` view is
// defined above; these functions remain for FFI/MMIO buffers and old callers.
//
// Reads mask with 0xFF because `char` sign-extends when widened to i32, which
// would make any byte >= 0x80 compare as negative.

/** Measure a NUL-terminated string.
 * @param s String to measure.
 * @return Number of bytes before the terminator.
 */
export i32 len(char* s) {
    i32 n = 0;
    for (; s[n] != 0; n++) {}
    return n;
}

/** Compare strings lexicographically using unsigned byte values.
 * @param a First string.
 * @param b Second string.
 * @return Negative, zero, or positive when a is less than, equal to, or greater than b.
 */
export i32 cmp(char* a, char* b) {
    i32 i = 0;
    while (1) {
        i32 ca = (i32)a[i] & 0xFF;
        i32 cb = (i32)b[i] & 0xFF;
        if (ca != cb) {
            return ca - cb;
        }
        if (ca == 0) {
            return 0;
        }
        i++;
    }
}

/** Check whether two strings contain the same bytes.
 * @param a First string.
 * @param b Second string.
 * @return True when the strings are equal.
 */
export bool eq(char* a, char* b) {
    return cmp(a, b) == 0;
}

/** Compare at most n bytes using unsigned byte values.
 * @param a First string.
 * @param b Second string.
 * @param n Maximum number of bytes to compare.
 * @return Negative, zero, or positive according to lexicographic order.
 */
export i32 ncmp(char* a, char* b, i32 n) {
    i32 i = 0;
    while (i < n) {
        i32 ca = (i32)a[i] & 0xFF;
        i32 cb = (i32)b[i] & 0xFF;
        if (ca != cb) {
            return ca - cb;
        }
        if (ca == 0) {
            return 0;
        }
        i++;
    }
    return 0;
}

/** Check whether s begins with prefix.
 * @param s String to inspect.
 * @param prefix Prefix to match.
 * @return True when s starts with prefix.
 */
export bool starts_with(char* s, char* prefix) {
    i32 i = 0;
    while (prefix[i] != 0) {
        i32 cs = (i32)s[i] & 0xFF;
        i32 cp = (i32)prefix[i] & 0xFF;
        if (cs != cp) {
            return false;
        }
        i++;
    }
    return true;
}

/** Copy a NUL-terminated string, including its terminator.
 * @param dst Destination with room for len(src) + 1 bytes.
 * @param src Source string.
 * @return Number of non-terminator bytes copied.
 */
export i32 copy(char* dst, char* src) {
    i32 i = 0;
    while (src[i] != 0) {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return i;
}

/** Copy a string into a bounded destination and always terminate when cap is positive.
 * @param dst Destination buffer.
 * @param src Source string.
 * @param cap Destination capacity including the terminator.
 * @return Number of non-terminator bytes written; compare with len(src) to detect truncation.
 */
export i32 ncopy(char* dst, char* src, i32 cap) {
    if (cap <= 0) {
        return 0;
    }
    i32 i = 0;
    while (i < cap - 1) {
        if (src[i] == 0) {
            break;
        }
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return i;
}

/** Append src to dst, including a final terminator.
 * @param dst Destination with room for both strings and the terminator.
 * @param src String to append.
 * @return Resulting string length, excluding the terminator.
 */
export i32 cat(char* dst, char* src) {
    i32 n = len(dst);
    i32 i = 0;
    while (src[i] != 0) {
        dst[n + i] = src[i];
        i++;
    }
    dst[n + i] = 0;
    return n + i;
}

/** Find the first occurrence of a byte in a string.
 * @param s NUL-terminated string to search.
 * @param c Byte value to find; only its low 8 bits are used.
 * @return Byte index, or None when absent. Searching for zero returns the terminator index.
 */
export Option<i32> chr(char* s, i32 c) {
    i32 i = 0;
    i32 want = c & 0xFF;
    while (s[i] != 0) {
        if (((i32)s[i] & 0xFF) == want) {
            return Some(i);
        }
        i++;
    }
    if (want == 0) {
        return Some(i);
    }
    return None;
}

/** Find a substring.
 * @param haystack String to search.
 * @param needle Substring to find; an empty needle matches at index zero.
 * @return First matching byte index, or None when absent.
 */
export Option<i32> find(char* haystack, char* needle) {
    if (needle[0] == 0) {
        return Some(0);
    }
    i32 i = 0;
    while (haystack[i] != 0) {
        if (starts_with(&haystack[i], needle)) {
            return Some(i);
        }
        i++;
    }
    return None;
}

/** Convert a signed integer to a NUL-terminated decimal string.
 * @param value Integer to convert.
 * @param buf Destination with room for the result and terminator.
 * @return Number of characters written, excluding the terminator.
 */
export i32 itoa(i32 value, char* buf) {
    if (value == 0) {
        buf[0] = 48; // '0'
        buf[1] = 0;
        return 1;
    }

    // Negating the minimum signed value cannot be represented as i32.
    if (value == -2147483647 - 1) {
        char minimum[12] = "-2147483648";
        i32 i = 0;
        while (i < 12) { buf[i] = minimum[i]; i++; }
        return 11;
    }

    bool is_negative = value < 0;
    if (is_negative) { value = 0 - value; }
    i32 remaining = value;
    i32 length = 0;
    while (remaining != 0) {
        i32 digit = remaining % 10;
        buf[length] = 48 + digit; // '0' + digit, temporarily reversed
        length++;
        remaining = remaining / 10;
    }
    if (is_negative) {
        buf[length] = 45; // '-'
        length++;
    }

    i32 left = 0;
    i32 right = length - 1;
    while (left < right) {
        char tmp = buf[left];
        buf[left] = buf[right];
        buf[right] = tmp;
        left++;
        right--;
    }
    buf[length] = 0;
    return length;
}

/** Convert an integer into an owned, inline decimal string.
 * @return Decimal representation with no allocation.
 */
export InlineString<12> (i32 self) to_string() {
    InlineString<12> result = InlineString<12> {};
    if (self == 0) {
        result.push((u8)'0');
    } else if (self == -2147483647 - 1) {
        result.append("-2147483648");
    } else {
        i32 value = self;
        bool negative = value < 0;
        if (negative) { value = 0 - value; }
        while (value != 0) {
            result.push((u8)('0' + value % 10));
            value = value / 10;
        }
        if (negative) { result.push((u8)'-'); }

        i32 left = 0;
        i32 right = result.length - 1;
        while (left < right) {
            u8 byte = result.data[left];
            result.data[left] = result.data[right];
            result.data[right] = byte;
            left++;
            right--;
        }
    }
    return result;
}

/** Convert an integer to lowercase hexadecimal without a prefix.
 * @param value Integer interpreted as a 32-bit value.
 * @param buf Destination with room for the result and terminator.
 * @return Number of characters written, excluding the terminator.
 */
export i32 xtoa(i32 value, char* buf) {
    if (value == 0) {
        buf[0] = 48; // '0'
        buf[1] = 0;
        return 1;
    }

    // Count nibbles, skipping leading zeros. Shifting right by 4 keeps this
    // free of the multiply and divide the target has no instruction for.
    i32 shift = 28;
    while (shift > 0) {
        if ((value >> shift) & 15) {
            break;
        }
        shift = shift - 4;
    }

    i32 n = 0;
    while (shift >= 0) {
        i32 nibble = (value >> shift) & 15;
        if (nibble < 10) {
            buf[n] = 48 + nibble;  // '0'
        } else {
            buf[n] = 87 + nibble;  // 'a' - 10
        }
        n++;
        shift = shift - 4;
    }
    buf[n] = 0;
    return n;
}

/** Parse a signed decimal prefix from a string.
 * Parsing stops at the first non-digit byte.
 * @param s String to parse; an optional leading plus or minus is accepted.
 * @return Parsed integer, or zero when no decimal digits follow the optional sign.
 */
export i32 atoi(char* s) {
    i32 i = 0;
    i32 sign = 1;

    if (s[0] == 45) {        // '-'
        sign = -1;
        i = 1;
    } else if (s[0] == 43) { // '+'
        i = 1;
    }

    i32 value = 0;
    while (1) {
        i32 c = (i32)s[i] & 0xFF;
        if (c < 48 || c > 57) {
            break;
        }
        // value * 10 as shifts: the target has no multiply instruction, so
        // codegen would otherwise expand this into a repeated-add loop.
        value = (value << 3) + (value << 1) + (c - 48);
        i++;
    }

    if (sign < 0) {
        return 0 - value;
    }
    return value;
}
