package text;

/** Fixed-capacity text stored entirely inside the value; it never allocates.
 *
 * `N` is the size of the inline buffer in bytes. One of them always holds
 * a NUL after the text, so a `Text<N>` holds up to N - 1 bytes and can be
 * handed to an API that still takes `char *` (`as_ptr()`). Embedded NUL is
 * therefore rejected. Mutations are atomic: one that does not fit changes
 * nothing and returns false. A zero value is the empty text.
 *
 * Read it as a `str` with `as_str()`. Text that must grow lives in the heap
 * as a `String`.
 *
 * @property data Inline storage: the text, then a NUL terminator.
 * @property length Number of text bytes before the terminator.
 */
export struct Text<const N> {
    char data[N];
    i32 length;
};

/** Make the text empty. A zero value already is; this is for reuse. */
@safe
export void (borrow Text<N> self) init() {
    self.length = 0;
    self.data[0] = (char)0;
}

/** Return the number of text bytes, excluding the terminator. */
@safe
export i32 (Text<N> self) len() { return self.length; }

/** Return the maximum text length: N - 1, leaving room for the terminator. */
@safe
export i32 (Text<N> self) capacity() { return self.data.length - 1; }

/** Return the unused text capacity. */
@safe
export i32 (Text<N> self) remaining() {
    return self.capacity() - self.length;
}

/** Test whether the text is empty. */
@safe
export bool (Text<N> self) is_empty() { return self.length == 0; }

/** Remove all text and restore the terminator. */
@safe
export void (borrow Text<N> self) clear() {
    self.length = 0;
    self.data[0] = (char)0;
}

/** Append a complete string view.
 * @param value Bytes to append. Embedded NUL is rejected because the text
 * must stay a valid C string.
 * @return True on success; false leaves self unchanged.
 */
@safe
export bool (borrow Text<N> self) append(str value) {
    if (value.length > self.remaining()) { return false; }
    i32 i = 0;
    while (i < value.length) {
        if (value.data[i] == 0) { return false; }
        i++;
    }
    i = 0;
    while (i < value.length) {
        self.data[self.length + i] = value.data[i];
        i++;
    }
    self.length = self.length + value.length;
    self.data[self.length] = (char)0;
    return true;
}

/** Append one non-NUL byte atomically. */
@safe
export bool (borrow Text<N> self) push(u8 value) {
    if (value == 0 || self.length >= self.capacity()) { return false; }
    self.data[self.length] = (char)value;
    self.length++;
    self.data[self.length] = (char)0;
    return true;
}

/** Shorten the text to at most length bytes. */
@safe
export void (borrow Text<N> self) truncate(i32 length) {
    if (length < 0) { length = 0; }
    if (length < self.length) { self.length = length; }
    self.data[self.length] = (char)0;
}

/** Borrow the text bytes as a length-aware MyLang string. */
@safe
export str (Text<N> self) as_str() {
    return str { data: &self.data[0], length: self.length };
}

/** Borrow the NUL-terminated representation for a system call that still
 * takes `char *`. */
export char * (Text<N> self) as_ptr() { return &self.data[0]; }

/** Recompute the length after a system call wrote through as_ptr().
 * @return True when a terminator was found; false when the buffer had to be
 * terminated at its final byte.
 */
export bool (borrow Text<N> self) sync_from_ptr() {
    i32 i = 0;
    while (i < self.data.length) {
        if (self.data[i] == 0) {
            self.length = i;
            return true;
        }
        i++;
    }
    self.length = self.data.length - 1;
    self.data[self.length] = (char)0;
    return false;
}
