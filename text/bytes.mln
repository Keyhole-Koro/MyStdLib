package bytes;

import { Option } from "../option.mln";

// Raw byte-buffer operations: the memset / memcpy / memcmp layer.
//
// Named `bytes` rather than `mem` because `package mem` (src/mm/mem.mln) is
// already the kernel's word-level absolute-address accessor for RAM and MMIO.
// This package is the byte-oriented counterpart and holds no state.
//
// Every count is in bytes and every buffer is caller-owned; nothing here
// allocates. Reads mask with 0xFF because `char` sign-extends into i32.

/** Fill dst with the low byte of value.
 * @param dst Destination buffer of at least n bytes.
 * @param value Integer whose low byte is repeated.
 * @param n Number of bytes to write.
 * @return Number of bytes written.
 */
export i32 set(char* dst, i32 value, i32 n) {
    i32 v = value & 0xFF;
    i32 i = 0;
    while (i < n) {
        dst[i] = v;
        i++;
    }
    return n;
}

/** Fill dst with zero bytes.
 * @param dst Destination buffer of at least n bytes.
 * @param n Number of bytes to clear.
 * @return Number of bytes written.
 */
export i32 zero(char* dst, i32 n) {
    return set(dst, 0, n);
}

/** Copy n bytes from src to dst; the ranges must not overlap.
 * @param dst Destination buffer of at least n bytes.
 * @param src Source buffer of at least n readable bytes.
 * @param n Number of bytes to copy.
 * @return Number of bytes copied.
 */
export i32 copy(char* dst, char* src, i32 n) {
    i32 i = 0;
    while (i < n) {
        dst[i] = src[i];
        i++;
    }
    return n;
}

/** Copy n bytes from src to dst, including when the ranges overlap.
 * @param dst Destination buffer.
 * @param src Source buffer.
 * @param n Number of bytes to copy.
 * @return Number of bytes copied.
 */
export i32 move(char* dst, char* src, i32 n) {
    if (dst == src || n <= 0) {
        return n;
    }

    if (dst < src) {
        return copy(dst, src, n);
    }

    i32 i = n - 1;
    while (i >= 0) {
        dst[i] = src[i];
        i = i - 1;
    }
    return n;
}

/** Compare two byte ranges using unsigned byte values.
 * @param a First range of n bytes.
 * @param b Second range of n bytes.
 * @param n Number of bytes to compare.
 * @return Negative, zero, or positive when a is less than, equal to, or greater than b.
 */
export i32 cmp(char* a, char* b, i32 n) {
    i32 i = 0;
    while (i < n) {
        i32 ca = (i32)a[i] & 0xFF;
        i32 cb = (i32)b[i] & 0xFF;
        if (ca != cb) {
            return ca - cb;
        }
        i++;
    }
    return 0;
}

/** Check whether two byte ranges are equal.
 * @param a First range of n bytes.
 * @param b Second range of n bytes.
 * @param n Number of bytes to compare.
 * @return True when all n bytes match.
 */
export bool eq(char* a, char* b, i32 n) {
    if (cmp(a, b, n) == 0) {
        return true;
    }
    return false;
}

/** Find the first occurrence of a byte value in a buffer.
 * @param buf Buffer to search.
 * @param n Number of bytes to inspect.
 * @param value Byte value to find; only its low 8 bits are used.
 * @return Index of the first match, or None if absent.
 */
export Option<i32> find(char* buf, i32 n, i32 value) {
    i32 want = value & 0xFF;
    i32 i = 0;
    while (i < n) {
        if (((i32)buf[i] & 0xFF) == want) {
            return Some(i);
        }
        i++;
    }
    return None;
}
