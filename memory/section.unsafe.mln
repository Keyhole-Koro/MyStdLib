package section;

// Linker-collected sections, looked up by name.
//
// Every `.section NAME` block an object contributes is laid out by the
// linker contiguously with the other objects' blocks of the same name, and
// the linker leaves a directory of what it collected (`__sections`, see
// toolchain/MyLinker/inc/ObjectFormat.h): one row per section name --
// [name (char*), start address, byte count] -- ending in a zero row.
// That directory is what this package reads, so a section can be found by
// its string name at runtime; no `extern` declaration per section is needed.
//
//     import { as_slice } from ".../memory/section.mln";
//     Slice<AnnotationRow> rows = as_slice<AnnotationRow>("annotations");
//
// The compiler's own use is the annotation metadata table (meta/annotations.mln).

import { Slice } from "slice.mln";
import { Option } from "@std/core/option.mln";
import str from "@std/text/str.mln";

extern i32 __sections[];

// Directory row of `name`, or None.
Option<i32> find(str name) {
    i32 i = 0;
    while (__sections[i * 3] != 0) {
        char *section_name = (char*)__sections[i * 3];
        if (section_name.as_str() == name) { return Some(i); }
        i++;
    }
    return None;
}

/** Check whether the linker collected a named section.
 * @param name Section name.
 * @return True when at least one object contributed the section.
 */
@safe
export bool exists(str name) {
    return case find(name) of {
        Some(_) -> true;
        None -> false;
    };
}

// Address of a collected section's first byte, or None when it is absent.
Option<i32> start(str name) {
    i32 i = case find(name) of {
        Some(v) -> v;
        None -> ({ return None; });
    };
    return Some(__sections[i * 3 + 1]);
}

// Combined size of a collected section in bytes, or None when it is absent.
Option<i32> size(str name) {
    i32 i = case find(name) of {
        Some(v) -> v;
        None -> ({ return None; });
    };
    return Some(__sections[i * 3 + 2]);
}

/** View a collected section as a slice of T.
 * The element count is the section byte size divided by sizeof(T).
 * @param name Section name.
 * @return Slice over the section, or an empty slice when it is absent.
 */
export Slice<T> as_slice<T>(str name) {
    Slice<T> s;
    T *data = (T*)0;
    i32 len = 0;
    case start(name) of {
        Some(address) -> ({
            data = (T*)address;
            case size(name) of {
                Some(bytes) -> ({ len = bytes / sizeof(T); });
                None -> _;
            };
        });
        None -> _;
    };
    s.init(data, len);
    return s;
}
