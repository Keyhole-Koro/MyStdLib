package section;

// Linker-collected sections, looked up by name.
//
// Every `.section NAME` block an object contributes is laid out by the
// linker contiguously with the other objects' blocks of the same name, and
// the linker leaves a directory of what it collected (`__sections`, see
// toolchain/MyLinker/inc/ObjectFormat.h): one row per section name --
// [name (char*), start address, byte count] -- ending in a zero row.
// That directory is what this package reads, so a section can be found by
// its string name at runtime; no `extern` declaration per section is needed.
//
//     import { as_slice } from ".../memory/section.mln";
//     Slice<AnnotationRow> rows = as_slice<AnnotationRow>("annotations");
//
// The compiler's own use is the annotation metadata table (meta/annotations.mln).

import { Slice } from "slice.mln";
import str from "../str.mln";

extern i32 __sections[];

// Directory row of `name`, or -1.
i32 find(char *name) {
    i32 i = 0;
    while (__sections[i * 3] != 0) {
        if (str.eq((char*)__sections[i * 3], name)) { return i; }
        i++;
    }
    return -1;
}

// Whether any object contributed a section of this name.
export bool exists(char *name) {
    return find(name) >= 0;
}

// Address of the section's first byte, or 0.
export i32 start(char *name) {
    i32 i = find(name);
    if (i < 0) { return 0; }
    return __sections[i * 3 + 1];
}

// Byte count of the section (all objects' blocks together), or 0.
export i32 size(char *name) {
    i32 i = find(name);
    if (i < 0) { return 0; }
    return __sections[i * 3 + 2];
}

// The section as a slice of T: `size / sizeof(T)` elements starting at
// `start`. An absent section is an empty slice. (A generic is instantiated
// in the importing module, so this body only uses this package's exported
// entry points.)
export Slice<T> as_slice<T>(char *name) {
    Slice<T> s;
    T *data = (T*)start(name);
    i32 len = 0;
    if (data != 0) { len = size(name) / sizeof(T); }
    s.init(data, len);
    return s;
}
