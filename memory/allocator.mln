package allocator;

import { Result } from "@std/core/result.mln";

/** Reasons an allocation request can fail. */
export enum AllocationError {
    InvalidSize,
    OutOfMemory,
    NotConfigured,
}

// The executable selects its allocator at startup. Keeping these as function
// pointers lets the same owned containers run in the kernel, an application
// process, or a freestanding compiler test without depending on one runtime.
Result<i32, AllocationError> not_configured(i32 size) {
    return Err(AllocationError::NotConfigured);
}

void nothing_to_free(i32 pointer) { }

fn(i32 size) -> Result<i32, AllocationError> g_allocate = not_configured;
fn(i32 pointer) -> void g_deallocate = nothing_to_free;

/** Installs the allocation functions used by owned standard-library values.
 * @param allocate Function `(i32 size) -> Result<i32, AllocationError>`.
 * @param deallocate Function `(i32 pointer) -> void`; pointer may be zero.
 */
export void configure(
    fn(i32 size) -> Result<i32, AllocationError> allocate,
    fn(i32 pointer) -> void deallocate
) {
    g_allocate = allocate;
    g_deallocate = deallocate;
}

/** Allocates size bytes with the configured runtime allocator.
 * @return `Ok(address)` on success, or `Err(AllocationError)` on failure.
 */
export Result<i32, AllocationError> alloc(i32 size) {
    if (size <= 0) { return Err(AllocationError::InvalidSize); }
    return g_allocate(size);
}

/** Releases an allocation through the configured runtime allocator. */
export void free(i32 pointer) {
    if (pointer != 0) { g_deallocate(pointer); }
}
