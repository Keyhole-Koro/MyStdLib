// Typed bump allocator over caller-owned storage. Reset invalidates all prior
// allocations and allocation returns NULL on exhaustion.
//
//     Arena<Node> a;
//     a.init(storage, 16);
//     Node *n = a.alloc(2);
//     a.reset();
export struct Arena<T> {
    T *data;
    i32 cap;
    i32 used;
};

export void (Arena<T> *a) init(T *storage, i32 cap) {
    a->data = storage;
    a->cap = cap;
    a->used = 0;
}

export void (Arena<T> *a) reset() {
    a->used = 0;
}

export T *(Arena<T> *a) alloc(i32 count) {
    if (count < 0 || count > a->cap - a->used) {
        return (T *)0;
    }
    T *result = a->data + a->used;
    a->used = a->used + count;
    return result;
}
