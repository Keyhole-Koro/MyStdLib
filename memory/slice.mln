// Borrowed contiguous range over caller-owned storage.
//
//     Slice<i32> s;
//     s.init(storage, 4);
//     i32 n = s.len();
//     i32 *p = s.at(2);     // 0 when out of range
export struct Slice<T> {
    T *data;
    i32 len;
};

export void (Slice<T> *s) init(T *data, i32 len) {
    s->data = data;
    s->len = len;
}

export i32 (Slice<T> *s) len() {
    return s->len;
}

export T *(Slice<T> *s) at(i32 index) {
    if (index < 0 || index >= s->len) {
        return (T *)0;
    }
    return s->data + index;
}
