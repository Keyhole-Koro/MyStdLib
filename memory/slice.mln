import { Option } from "@std/core/option.mln";
import { Iterator } from "@std/core/iter.mln";

/** Borrowed contiguous range over caller-owned storage.
 * @property data Pointer to the first element; ownership stays with the caller.
 * @property len Number of elements in the range.
 */
//
//     Slice<i32> s;
//     s.init(storage, 4);
//     i32 n = s.len();
//     case s.at(2) of { Some(p) -> ...; None -> ...; }   // None when out of range
export struct Slice<T> {
    T *data;
    i32 len;
};

/** Initialize a borrowed range.
 * @param data First element, or null for an empty range.
 * @param len Number of elements accessible through the slice.
 */
export void (Slice<T> *s) init(T *data, i32 len) {
    s->data = data;
    s->len = len;
}

/** Return the number of elements in the range.
 * @return Element count.
 */
export i32 (Slice<T> *s) len() {
    return s->len;
}

/** Find an element by zero-based index.
 * @param index Element index.
 * @return The element's address, or None when index is out of range.
 */
export Option<T *> (Slice<T> *s) at(i32 index) {
    if (index < 0 || index >= s->len) {
        return None;
    }
    return Some(s->data + index);
}

/** Walks contiguous elements front to back, yielding a pointer to each, so
 * elements are neither copied nor moved:
 *
 *     for (i32 *x in s.iter()) { sum = sum + *x; }
 *
 * @property cursor Next element.
 * @property left Elements not yet yielded.
 */
export struct SliceIter<T> {
    T *cursor;
    i32 left;
};

export impl<T> Iterator<T *> for SliceIter<T> {
    Option<T *> (Self *self) next() {
        if (self->left <= 0) { return None; }
        T *item = self->cursor;
        self->cursor = self->cursor + 1;
        self->left = self->left - 1;
        return Some(item);
    }
}

/** An iterator over the range's elements. */
export SliceIter<T> (Slice<T> *s) iter() {
    return SliceIter<T> { cursor: s->data, left: s->len };
}
