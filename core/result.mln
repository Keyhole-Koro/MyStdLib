/** A value that contains either a successful result or an error.
 * Construct with `Ok(value)` or `Err(error)`, and inspect with `case`.
 * @property Ok Contains the successful value.
 * @property Err Contains the error value.
 */
import { Option } from "option.mln";

export enum Result<T, E> {
    Ok(T),
    Err(E),
}

/** True for Ok. */
export bool (borrow Result<T, E> self) is_ok() {
    return case *self of { Ok(_) -> true; Err(_) -> false; };
}

/** True for Err. */
export bool (borrow Result<T, E> self) is_err() {
    return case *self of { Ok(_) -> false; Err(_) -> true; };
}

/** The Ok value, or `fallback` for an Err. Consumes the result.
 * @param fallback Value returned for Err.
 */
export T (Result<T, E> self) unwrap_or(T fallback) {
    return case self of { Ok(value) -> value; Err(_) -> fallback; };
}

/** The Ok value as an Option, dropping the error. Consumes the result. */
export Option<T> (Result<T, E> self) ok() {
    return case self of { Ok(value) -> Some(value); Err(_) -> None; };
}

/** The error as an Option. Consumes the result. */
export Option<E> (Result<T, E> self) err() {
    return case self of { Ok(_) -> None; Err(error) -> Some(error); };
}
