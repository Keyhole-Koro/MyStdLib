/** A value that contains either a successful result or an error.
 * Construct with `Ok(value)` or `Err(error)`, and inspect with `case`.
 * @property Ok Contains the successful value.
 * @property Err Contains the error value.
 */
export enum Result<T, E> {
    Ok(T),
    Err(E),
}

/** Copy the Ok payload to out when successful.
 * @param result Result value to inspect.
 * @param out Destination for the Ok payload; unchanged for Err.
 * @return True for Ok, false for Err.
 */
export bool result_take_ok<T, E>(Result<T, E> *result, T *out) {
    return case *result of {
        Ok(v)  -> ({ *out = v; true; });
        Err(e) -> false;
    };
}

/** Copy the Err payload to out when the result is an error.
 * @param result Result value to inspect.
 * @param out Destination for the Err payload; unchanged for Ok.
 * @return True for Err, false for Ok.
 */
export bool result_take_err<T, E>(Result<T, E> *result, E *out) {
    return case *result of {
        Ok(v)  -> false;
        Err(e) -> ({ *out = e; true; });
    };
}
