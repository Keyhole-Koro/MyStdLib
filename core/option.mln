/** An optional value represented by a payload enum.
 * Construct with `Some(value)` or `None`, and inspect with `case`.
 * @property Some Contains the present value.
 * @property None Represents the absence of a value.
 */
export enum Option<T> {
    Some(T),
    None,
}

/** True when the option holds a value. */
export bool (Option<T> self) is_some() {
    return case self of { Some(_) -> true; None -> false; };
}

/** True when the option holds nothing. */
export bool (Option<T> self) is_none() {
    return case self of { Some(_) -> false; None -> true; };
}

/** The value, or `fallback` when there is none. Consumes the option.
 * @param fallback Value returned for None.
 */
export T (move Option<T> self) unwrap_or(move T fallback) {
    return case self of { Some(value) -> value; None -> fallback; };
}
