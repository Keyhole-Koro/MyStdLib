// Fixed-capacity vector over caller-owned storage.
export struct Vec<T> {
    T *data;
    i32 len;
    i32 cap;
};

export void vec_init<T>(Vec<T> *vec, T *storage, i32 cap) {
    vec->data = storage;
    vec->len = 0;
    vec->cap = cap;
}

export i32 vec_len<T>(Vec<T> *vec) {
    return vec->len;
}

export bool vec_push<T>(Vec<T> *vec, T value) {
    if (vec->len >= vec->cap) {
        return false;
    }
    T *data = vec->data;
    data[vec->len] = value;
    vec->len++;
    return true;
}

export bool vec_pop<T>(Vec<T> *vec, T *out) {
    if (vec->len == 0) {
        return false;
    }
    vec->len--;
    T *data = vec->data;
    *out = data[vec->len];
    return true;
}

export T *vec_at<T>(Vec<T> *vec, i32 index) {
    if (index < 0 || index >= vec->len) {
        return (T *)0;
    }
    return vec->data + index;
}
