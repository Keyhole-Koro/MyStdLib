// Fixed-capacity vector over caller-owned storage.
//
//     Vec<i32> v;
//     v.init(storage, 8);
//     v.push(3);            // false when full
//     i32 *p = v.at(0);     // 0 when out of range
export struct Vec<T> {
    T *data;
    i32 len;
    i32 cap;
};

export void (Vec<T> *v) init(T *storage, i32 cap) {
    v->data = storage;
    v->len = 0;
    v->cap = cap;
}

export i32 (Vec<T> *v) len() {
    return v->len;
}

export bool (Vec<T> *v) push(T value) {
    if (v->len >= v->cap) {
        return false;
    }
    T *data = v->data;
    data[v->len] = value;
    v->len++;
    return true;
}

export bool (Vec<T> *v) pop(T *out) {
    if (v->len == 0) {
        return false;
    }
    v->len--;
    T *data = v->data;
    *out = data[v->len];
    return true;
}

export T *(Vec<T> *v) at(i32 index) {
    if (index < 0 || index >= v->len) {
        return (T *)0;
    }
    return v->data + index;
}
