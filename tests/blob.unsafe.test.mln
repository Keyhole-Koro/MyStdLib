import str from "@std/text/str.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import allocator from "@std/memory/allocator.mln";
import { AllocationError } from "@std/memory/allocator.mln";
import blob from "@std/memory/blob.mln";
import { Blob } from "@std/memory/blob.mln";
import assert from "@std/testing/assert.mln";
import { assert_eq, assert_ne } from "@std/testing/assert.mln";

// A Blob is a checked index into blob.mln's table: a forged or stale handle
// must reach nothing, and a slot is reused only after collect().
//
// The allocator is a bump pool that counts frees; each case is built and run
// on its own, so the pool and the blob table start empty every time.

char g_pool[65536];
i32 g_pool_used = 0;
i32 g_frees = 0;

Result<i32, AllocationError> pool_alloc(i32 size) {
    if (g_pool_used + size > 65536) { return Err(AllocationError::OutOfMemory); }
    i32 at = g_pool_used;
    g_pool_used = g_pool_used + ((size + 3) / 4) * 4;
    return Ok((i32)(&g_pool[at]));
}

void pool_free(i32 pointer) { g_frees++; }

Blob made(i32 cap) {
    Blob none = Blob { id: 0 };
    return case blob.blob_new(cap) of {
        Some(b) -> b;
        None -> ({ assert.assert_true(false, "blob_new failed"); none; });
    };
}

i32 slot_of(Blob b) { return b.id & 4095; }

/*@Test "Blob refuses forged handles" {
    step: 200000000;
}*/
void forged_handles() {
    allocator.configure(pool_alloc, pool_free);
    Blob none = Blob { id: 0 };
    assert_eq<bool>(none.is_live(), false, "the zero handle before any blob");
    Blob b = made(4);
    b.write("abcd");
    assert_eq<bool>(b.is_live(), true, "a new blob is live");
    assert_eq<bool>(none.is_live(), false, "the zero handle names nothing");

    Blob other_gen = Blob { id: b.id + 4096 };
    assert_eq<bool>(other_gen.is_live(), false, "a handle with another generation");
    assert_eq<i32>(other_gen.cap(), 0, "a forged handle has no capacity");
    assert_eq<i32>(other_gen.at(0), 0, "a forged handle reads zero");
    assert_eq<i32>(other_gen.write("zz"), 0, "a forged handle writes nothing");
    other_gen.put(0, 0x5A);
    other_gen.free();
    assert.assert_str_eq(other_gen.as_str(), "", "a forged handle reads empty");
    assert.assert_str_eq(b.as_str(), "abcd", "a forged handle leaves the real blob");
    assert_eq<bool>(b.is_live(), true, "a forged free leaves the real blob live");

    Blob unused_slot = Blob { id: 7 };
    assert_eq<bool>(unused_slot.is_live(), false, "a slot never handed out");
    Blob past_table = Blob { id: 4095 };
    assert_eq<bool>(past_table.is_live(), false, "a slot past the table");
    assert_eq<bool>(blob.blob_new(0 - 1).is_none(), true, "a negative capacity");
}

/*@Test "Blob handles go stale on free and slots wait for collect" {
    step: 200000000;
}*/
void stale_and_reuse() {
    allocator.configure(pool_alloc, pool_free);
    Blob a = made(4);
    a.write("old!");
    Blob keep = made(2);
    keep.write("ok");
    a.free();
    assert_eq<bool>(a.is_live(), false, "a freed handle is stale");
    assert_eq<i32>(a.write("new"), 0, "a stale handle writes nothing");
    assert_eq<i32>(a.cap(), 0, "a stale handle has no capacity");
    a.free();                  // a second free does nothing

    Blob before_collect = made(4);
    assert_ne<i32>(slot_of(before_collect), slot_of(a), "a freed slot is not reused before collect");
    assert_eq<i32>(g_frees, 0, "free does not release the bytes");

    blob.collect();
    assert_eq<i32>(g_frees, 1, "collect releases the freed bytes once");
    blob.collect();
    assert_eq<i32>(g_frees, 1, "a second collect has nothing to release");

    Blob reused = made(4);
    assert_eq<i32>(slot_of(reused), slot_of(a), "collect makes the slot reusable");
    assert_ne<i32>(reused.id, a.id, "the reused slot has a new generation");
    assert_eq<bool>(a.is_live(), false, "the old handle stays stale after reuse");
    assert.assert_str_eq(reused.as_str(), "", "a reused slot starts empty");
    assert.assert_str_eq(keep.as_str(), "ok", "other blobs are untouched");
}

/*@Test "Blob at, put and write stay inside the buffer" {
    step: 200000000;
}*/
void bounds() {
    allocator.configure(pool_alloc, pool_free);
    Blob b = made(3);
    assert_eq<i32>(b.cap(), 3, "capacity");
    b.put(0, 0x41);
    b.put(1, 0xFF);
    b.put(0 - 1, 0x58);
    b.put(3, 0x58);
    assert_eq<i32>(b.at(0), 0x41, "a stored byte");
    assert_eq<i32>(b.at(1), 255, "a high byte reads unsigned");
    assert_eq<i32>(b.at(0 - 1), 0, "before the buffer reads zero");
    assert_eq<i32>(b.at(3), 0, "past the buffer reads zero");
    assert_eq<i32>(b.write("abcdef"), 3, "write is cut to the capacity");
    assert.assert_str_eq(b.as_str(), "abc", "contents after a cut write");
    assert_eq<i32>(b.write("z"), 1, "a shorter write");
    assert.assert_str_eq(b.as_str(), "z", "a shorter write replaces the contents");

    Blob from = case blob.blob_from("hi") of {
        Some(v) -> v;
        None -> ({ assert.assert_true(false, "blob_from failed"); return; });
    };
    assert_eq<i32>(from.cap(), 2, "blob_from sizes the buffer to the text");
    assert.assert_str_eq(from.as_str(), "hi", "blob_from copies the text");
    Blob empty = made(0);
    assert_eq<bool>(empty.is_live(), true, "a zero-capacity blob");
    assert_eq<i32>(empty.write("x"), 0, "a zero-capacity blob takes nothing");
}
