package process;

// Generic process control for hosted MyLang programs. UI-specific stdout
// binding remains in MyAppFramework's terminal integration.

import myos_service from "@std/platform/myos/service.mln";
import { OsService } from "@contracts/myos/services.contract.mln";
import { Result } from "@std/core/result.mln";
import { SpawnError } from "@contracts/process/spawn.contract.mln";
import { SyscallFailure } from "@contracts/myos/syscall.contract.mln";
import { Pid, ProcessControlError, ProcessControlStatus, ProcessExitStatus } from "@contracts/process/control.contract.mln";
import { ProcSpawnArgs, ProcExitedArgs, ProcReapArgs, ProcFeedArgs } from "@contracts/myos/process-args.contract.mln";

/** Reads a service that answers in its status word, as PROC_FEED does.
 * @param pid Process the request named.
 * @param reply What the service call returned.
 * @return Ok(_), or Err(InvalidPid) when the OS refused or never answered.
 */
export Result<_, ProcessControlError> control_result(Pid pid, Result<i32, SyscallFailure> reply) {
    bool accepted = case reply of {
        Ok(word) -> word == (i32)ProcessControlStatus::Accepted;
        Err(_) -> false;
    };
    if (accepted) { return Ok(_); }
    return Err(ProcessControlError::InvalidPid(pid));
}

/** Start an executable process.
 * @param path Executable path.
 * @return New process ID, or the detailed spawn error.
 */
@safe
export Result<Pid, SpawnError> spawn(str path) {
    Result<Pid, SpawnError> result;
    ProcSpawnArgs<Result<Pid, SpawnError>> args = ProcSpawnArgs<Result<Pid, SpawnError>> {
        path: path.data, path_length: path.length, stdout_node: 0, result_out: &result
    };
    myos_service.call(OsService::PROC_SPAWN, (i32)(&args));
    return result;
}

/** Check whether a process has exited.
 * @param pid Process ID to query.
 * @return True if exited, false if still running, or a process-control error.
 */
@safe
export Result<bool, ProcessControlError> has_exited(Pid pid) {
    Result<bool, ProcessControlError> result;
    ProcExitedArgs<Result<bool, ProcessControlError>> args = ProcExitedArgs<Result<bool, ProcessControlError>> {
        pid: (i32)pid, result_out: &result
    };
    myos_service.call(OsService::PROC_EXITED, (i32)(&args));
    return result;
}

/** Reap an exited process and retrieve its typed termination status.
 * @param pid Process ID to reap.
 * @return Application exit code or kernel termination reason, or a process-control error.
 */
@safe
export Result<ProcessExitStatus, ProcessControlError> reap(Pid pid) {
    Result<ProcessExitStatus, ProcessControlError> result;
    ProcReapArgs<Result<ProcessExitStatus, ProcessControlError>> args = ProcReapArgs<Result<ProcessExitStatus, ProcessControlError>> {
        pid: (i32)pid, result_out: &result
    };
    myos_service.call(OsService::PROC_REAP, (i32)(&args));
    return result;
}

/** Send an input line to a process.
 * @param pid Recipient process ID.
 * @param line Line to deliver.
 * @return Ok(_), or Err(InvalidPid) when pid names no child of this process.
 */
@safe
export Result<_, ProcessControlError> feed_line(Pid pid, str line) {
    ProcFeedArgs args = ProcFeedArgs { pid: (i32)pid, line: line.data, line_length: line.length };
    return control_result(pid, myos_service.call(OsService::PROC_FEED, (i32)(&args)));
}
