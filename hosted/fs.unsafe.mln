package fs;

// Filesystem API for a hosted MyLang program. This is the client side of
// MyOS's filesystem service, not the filesystem implementation.

import myos_service from "@std/platform/myos/service.mln";
import { OsCall } from "@contracts/myos/services.contract.mln";
import { SyscallFailure } from "@contracts/myos/syscall.contract.mln";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { Text } from "@std/text/text.mln";
import { FsError, SeekWhence } from "@contracts/io/fs.contract.mln";
import {
    FsOpenArgs, FsCreateArgs, FsMkdirArgs, FsRemoveArgs, FsReadArgs,
    FsWriteArgs, FsSeekArgs, FsCloseArgs, FsDirNextArgs,
    FsEntrySizeArgs, FsIsDirArgs
} from "@contracts/myos/fs-args.contract.mln";

export const i32 NAME_MAX = 16;

/** One read: how many bytes the file gave, and those bytes as text.
 * @property got Bytes read; zero at end of file.
 * @property text The bytes, up to the first NUL.
 */
export struct FsChunk {
    i32 got;
    Text<128> text;
};

/** One directory entry.
 * @property index Filesystem entry index.
 * @property name Entry name.
 */
export struct DirEntry {
    i32 index;
    Text<16> name;
};

/**
 * Sends one argument record under the service its contract binds it to.
 * @param args Argument record; its result_out names the caller's reply slot.
 * @return The OS_CALL transport status; the service result is in result_out.
 */
Result<i32, SyscallFailure> send<A: OsCall>(A *args) {
    return myos_service.call(A::service(), (i32)args);
}

/** Open a filesystem path.
 * @param path Path to open.
 * @return File descriptor on success, or the filesystem error.
 */
@safe
export Result<i32, FsError> open(str path) {
    Result<i32, FsError> result;
    FsOpenArgs args = FsOpenArgs {
        path: path.data, path_length: path.length, result_out: &result
    };
    send<FsOpenArgs>(&args);
    return result;
}

/** Create and open a filesystem path.
 * @param path Path to create.
 * @return File descriptor on success, or the filesystem error.
 */
@safe
export Result<i32, FsError> create(str path) {
    Result<i32, FsError> result;
    FsCreateArgs args = FsCreateArgs {
        path: path.data, path_length: path.length, result_out: &result
    };
    send<FsCreateArgs>(&args);
    return result;
}

/** Read up to 127 bytes from an open file.
 * @param fd File descriptor.
 * @return The chunk (`got` is zero at end of file), or the filesystem error.
 */
@safe
export Result<FsChunk, FsError> read(i32 fd) {
    FsChunk chunk = FsChunk {};
    Result<i32, FsError> result;
    FsReadArgs args = FsReadArgs {
        fd: fd, buffer: chunk.text.as_ptr(), size: 127, result_out: &result
    };
    send<FsReadArgs>(&args);
    i32 got = case result of {
        Ok(value) -> value;
        Err(error) -> ({ return Err(error); });
    };
    chunk.got = got;
    char *bytes = chunk.text.as_ptr();
    if (got >= 0) { bytes[got] = (char)0; }
    chunk.text.sync_from_ptr();
    return Ok(chunk);
}

/** Write bytes to an open file.
 * @param fd File descriptor.
 * @param data Bytes to write.
 * @return Bytes written, or the filesystem error.
 */
@safe
export Result<i32, FsError> write(i32 fd, str data) {
    Result<i32, FsError> result;
    FsWriteArgs args = FsWriteArgs {
        fd: fd, buffer: data.data, size: data.length, result_out: &result
    };
    send<FsWriteArgs>(&args);
    return result;
}

/** Move the file cursor.
 * @param fd File descriptor.
 * @param offset Signed offset relative to whence.
 * @param whence Reference point for the offset.
 * @return New absolute file offset, or the filesystem error.
 */
@safe
export Result<i32, FsError> seek(i32 fd, i32 offset, SeekWhence whence) {
    Result<i32, FsError> result;
    FsSeekArgs args = FsSeekArgs {
        fd: fd, offset: offset, whence: whence, result_out: &result
    };
    send<FsSeekArgs>(&args);
    return result;
}

/** Close an open file descriptor.
 * @param fd File descriptor to close.
 */
@safe
export void close(i32 fd) {
    FsCloseArgs args = FsCloseArgs { fd: fd };
    send<FsCloseArgs>(&args);
}

/** Remove a filesystem entry.
 * @param path Path of the entry to remove.
 * @return Ok on success, or the filesystem error.
 */
@safe
export Result<_, FsError> remove(str path) {
    Result<_, FsError> result;
    FsRemoveArgs args = FsRemoveArgs {
        path: path.data, path_length: path.length, result_out: &result
    };
    send<FsRemoveArgs>(&args);
    return result;
}

/** Create a directory.
 * @param path Directory path.
 * @return Directory entry index, or the filesystem error.
 */
@safe
export Result<i32, FsError> mkdir(str path) {
    Result<i32, FsError> result;
    FsMkdirArgs args = FsMkdirArgs {
        path: path.data, path_length: path.length, result_out: &result
    };
    send<FsMkdirArgs>(&args);
    return result;
}

/** Find the next directory entry.
 * @param dir Directory path.
 * @param start Entry index at which to begin searching.
 * @return Ok(Some(entry)) when found, Ok(None) at end, or Err on failure.
 */
@safe
export Result<Option<DirEntry>, FsError> next_entry(str dir, i32 start) {
    DirEntry entry = DirEntry {};
    Result<Option<i32>, FsError> result;
    FsDirNextArgs args = FsDirNextArgs {
        path: dir.data, path_length: dir.length, start: start, name_out: entry.name.as_ptr(),
        name_cap: NAME_MAX, result_out: &result
    };
    send<FsDirNextArgs>(&args);
    Option<i32> found = case result of {
        Ok(value) -> value;
        Err(error) -> ({ return Err(error); });
    };
    i32 index = case found of {
        Some(value) -> value;
        None -> ({ return Ok(None); });
    };
    entry.index = index;
    entry.name.sync_from_ptr();
    return Ok(Some(entry));
}

/** Check whether a filesystem entry is a directory.
 * @param idx Filesystem entry index.
 * @return True if it is a directory, or the filesystem error.
 */
@safe
export Result<bool, FsError> is_dir(i32 idx) {
    Result<bool, FsError> result;
    FsIsDirArgs args = FsIsDirArgs {
        entry: idx, result_out: &result
    };
    send<FsIsDirArgs>(&args);
    return result;
}

/** Get the byte size of a filesystem entry.
 * @param idx Filesystem entry index.
 * @return Entry size in bytes, or the filesystem error.
 */
@safe
export Result<i32, FsError> entry_size(i32 idx) {
    Result<i32, FsError> result;
    FsEntrySizeArgs args = FsEntrySizeArgs {
        entry: idx, result_out: &result
    };
    send<FsEntrySizeArgs>(&args);
    return result;
}
