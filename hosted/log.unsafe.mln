package hosted_log;

import myos_service from "@std/platform/myos/service.mln";
import { OsService, LogArgs } from "@contracts/myos/services.contract.mln";

/** Write a message to the hosted OS diagnostic log.
 * @param message Diagnostic text.
 */
@safe
export void write(str message) {
    LogArgs args = LogArgs { text: message.data, length: message.length };
    myos_service.call(OsService::LOG, (i32)(&args));
}
