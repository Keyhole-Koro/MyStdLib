package hosted_log;

import myos_service from "@std/platform/myos/service.mln";
import { OsService } from "@contracts/myos/services.contract.mln";

/** Write a message to the hosted OS diagnostic log.
 * @param message NUL-terminated diagnostic text.
 */
export void write(char *message) { myos_service.call(OsService::LOG, (i32)message); }
